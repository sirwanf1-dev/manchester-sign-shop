---
const { images = [] } = Astro.props;
---

<div class="gallery" data-gallery>
  {images.map((image, index) => (
    <button class="gallery-card" type="button" data-index={index} aria-label={`Open project photo ${index + 1}`}>
      <img src={image} alt={`Manchester Sign Group project ${index + 1}`} loading="lazy" />
    </button>
  ))}
</div>

<div class="lightbox" data-lightbox aria-hidden="true">
  <button class="close" type="button" data-close aria-label="Close gallery">×</button>
  <button class="nav prev" type="button" data-prev aria-label="Previous photo">‹</button>
  <div class="viewport" data-viewport>
    <img data-lightbox-image alt="" draggable="false" />
  </div>
  <button class="nav next" type="button" data-next aria-label="Next photo">›</button>
  <div class="counter" data-counter></div>
</div>

<style>
  .gallery { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
  .gallery-card { padding:0; border:0; background:#111; aspect-ratio:3/2; overflow:hidden; cursor:pointer; }
  .gallery-card img { width:100%; height:100%; object-fit:cover; display:block; }
  .lightbox { position:fixed; inset:0; z-index:1000; display:none; align-items:center; justify-content:center; background:rgba(0,0,0,.96); touch-action:none; }
  .lightbox.open { display:flex; }
  .viewport { width:100%; height:100%; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .viewport img { max-width:94vw; max-height:88vh; object-fit:contain; user-select:none; transform-origin:center; will-change:transform; }
  .close,.nav { position:absolute; z-index:2; border:0; color:white; background:rgba(20,20,20,.7); cursor:pointer; }
  .close { top:18px; right:18px; width:46px; height:46px; border-radius:50%; font-size:30px; }
  .nav { top:50%; transform:translateY(-50%); width:48px; height:64px; font-size:44px; }
  .prev { left:12px; } .next { right:12px; }
  .counter { position:absolute; bottom:18px; color:white; font-size:13px; }
  @media (max-width:600px) { .gallery{grid-template-columns:1fr;} .nav{background:rgba(0,0,0,.35);} }
</style>

<script>
  const root = document.querySelector('[data-lightbox]');
  const viewport = document.querySelector('[data-viewport]');
  const image = document.querySelector('[data-lightbox-image]');
  const cards = [...document.querySelectorAll('[data-gallery] .gallery-card')];
  const close = document.querySelector('[data-close]');
  const prev = document.querySelector('[data-prev]');
  const next = document.querySelector('[data-next]');
  const counter = document.querySelector('[data-counter]');
  const sources = cards.map(card => card.querySelector('img').src);
  let current = 0;
  let scale = 1;
  let x = 0, y = 0;
  let startX = 0, startY = 0, startDistance = 0, startScale = 1;
  let dragging = false;
  let moved = false;

  function applyTransform() {
    image.style.transform = `translate3d(${x}px,${y}px,0) scale(${scale})`;
  }

  function resetZoom() {
    scale = 1; x = 0; y = 0; applyTransform();
  }

  function show(index) {
    if (!sources.length) return;
    current = (index + sources.length) % sources.length;
    image.src = sources[current];
    image.alt = `Manchester Sign Group project ${current + 1}`;
    counter.textContent = `${current + 1} / ${sources.length}`;
    resetZoom();
    root.classList.add('open');
    root.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function hide() {
    root.classList.remove('open');
    root.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    resetZoom();
  }

  cards.forEach((card, index) => card.addEventListener('click', () => show(index)));
  close.addEventListener('click', hide);
  prev.addEventListener('click', () => show(current - 1));
  next.addEventListener('click', () => show(current + 1));

  document.addEventListener('keydown', event => {
    if (!root.classList.contains('open')) return;
    if (event.key === 'Escape') hide();
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  function distance(a, b) {
    return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
  }

  viewport.addEventListener('pointerdown', event => {
    if (!root.classList.contains('open')) return;
    if (event.pointerType === 'touch') return;
    dragging = true; moved = false; startX = event.clientX - x; startY = event.clientY - y;
    viewport.setPointerCapture(event.pointerId);
  });

  viewport.addEventListener('pointermove', event => {
    if (!dragging) return;
    x = event.clientX - startX; y = event.clientY - startY; moved = true; applyTransform();
  });

  viewport.addEventListener('pointerup', () => { dragging = false; });

  let touches = [];
  viewport.addEventListener('touchstart', event => {
    touches = [...event.touches];
    if (touches.length === 2) {
      startDistance = distance(touches[0], touches[1]);
      startScale = scale;
    } else if (touches.length === 1) {
      startX = touches[0].clientX - x;
      startY = touches[0].clientY - y;
      moved = false;
    }
  }, { passive:false });

  viewport.addEventListener('touchmove', event => {
    event.preventDefault();
    const now = [...event.touches];
    if (now.length === 2 && startDistance) {
      scale = Math.min(4, Math.max(1, startScale * distance(now[0], now[1]) / startDistance));
      applyTransform();
    } else if (now.length === 1 && scale > 1) {
      x = now[0].clientX - startX;
      y = now[0].clientY - startY;
      moved = true;
      applyTransform();
    }
  }, { passive:false });

  viewport.addEventListener('touchend', event => {
    if (touches.length === 1 && event.changedTouches.length === 1 && !moved && scale === 1) {
      const end = event.changedTouches[0];
      const dx = end.clientX - touches[0].clientX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    }
    touches = [];
    startDistance = 0;
  });

  let lastTap = 0;
  viewport.addEventListener('touchend', () => {
    const now = Date.now();
    if (now - lastTap < 280) {
      scale = scale === 1 ? 2.2 : 1;
      if (scale === 1) { x = 0; y = 0; }
      applyTransform();
    }
    lastTap = now;
  });
</script>
