---
const {
  title = 'Manchester Sign Group | Business Signs & Sign-Making Supplies',
  description = 'Manchester Sign Group is based in Manchester and supplies signs and sign-making products across the UK, with throughout the United Kingdom delivery and a one-year product warranty.'
} = Astro.props;
const BASE = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: 'Manchester Sign Group',
  url: new URL('/', Astro.site).href,
  telephone: '+447594106206',
  areaServed: { '@type': 'Country', name: 'United Kingdom' },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+447594106206',
    contactType: 'customer service'
  }
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Manchester Sign Group',
  url: new URL('/', Astro.site).href,
  publisher: { '@id': organizationSchema['@id'] }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#050708" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manchester Sign Group" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <button class="menu-button" id="menuButton" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="siteMenu"><span></span><span></span><span></span></button>
      <a class="header-order" href="https://wa.me/447594106206?text=Hi%20Manchester%2C%20I%20would%20like%20to%20order%20a%20sign.%20Please%20let%20me%20know%20the%20next%20steps." target="_blank" rel="noopener">ORDER NOW <span>→</span></a>
    </header>
    <div class="menu-overlay" id="menuOverlay"></div>
    <aside class="site-menu" id="siteMenu" aria-hidden="true">
      <div class="menu-top"><strong>MENU</strong><button id="menuClose" type="button" aria-label="Close menu">×</button></div>
      <nav>
        <a href={`${BASE}`}>HOME <span>→</span></a>
        <a href={`${BASE}services/`}>OUR SERVICES <span>→</span></a>
        <a href={`${BASE}our-work/`}>OUR WORK <span>→</span></a>
        <a href={`${BASE}quote/`}>GET A QUOTE <span>→</span></a>
        <a href={`${BASE}faq/`}>FAQ <span>→</span></a>
        <a href={`${BASE}shop/`}>SHOP <span>→</span></a>
        <a href={`${BASE}contact/`}>CONTACT <span>→</span></a>
        <a href={`${BASE}location/`}>LOCATION <span>→</span></a>
        <a href={`${BASE}about/`}>ABOUT US <span>→</span></a>
      </nav>
      <a class="menu-whatsapp" href="https://wa.me/447594106206?text=Hi%20Manchester%2C%20I%20would%20like%20to%20ask%20about%20your%20sign%20services." target="_blank" rel="noopener">WHATSAPP US <span>→</span></a>
    </aside>
    <a class="floating-home" href={BASE} aria-label="Back to home">⌂ <span>HOME</span></a>
    <slot />
    <footer class="site-footer">
      <span>MANCHESTER SIGN GROUP</span>
      <span>SIGNS • SUPPLIES • EVERYTHING YOU NEED</span>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing:border-box; }
  :global(html) { width:100%; min-width:0; overflow-x:hidden; scroll-behavior:smooth; -webkit-text-size-adjust:100%; touch-action:manipulation; }
  :global(body) { width:100%; max-width:100%; min-width:0; margin:0; background:#050708; color:#f7f7f8; font-family:Arial,Helvetica,sans-serif; -webkit-font-smoothing:antialiased; overflow-x:hidden; }
  :global(img),:global(video) { max-width:100%; }
  :global(button),:global(a),:global(input),:global(select) { -webkit-tap-highlight-color:transparent; }
  .site-header { height:94px; position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between; padding:0 3.5%; background:rgba(5,7,8,.88); border-bottom:1px solid rgba(255,255,255,.12); backdrop-filter:blur(18px); }
  .menu-button { width:52px; height:48px; display:flex; flex-direction:column; justify-content:center; gap:7px; padding:0; border:0; background:transparent; cursor:pointer; }
  .menu-button span { display:block; width:41px; height:4px; border-radius:3px; background:#fff; }
  .header-order { display:flex; align-items:center; gap:10px; padding:17px 28px; border-radius:12px; background:#ff1730; color:#fff; text-decoration:none; font-size:16px; font-weight:900; letter-spacing:.4px; box-shadow:0 0 28px rgba(255,23,48,.28); }
  .header-order span { font-size:22px; line-height:1; }
  .menu-overlay { position:fixed; inset:0; z-index:190; background:rgba(0,0,0,.62); opacity:0; visibility:hidden; transition:.25s; }
  .site-menu { position:fixed; top:0; left:0; bottom:0; z-index:200; width:min(390px,88vw); padding:30px 28px; background:#0a0c0e; border-right:1px solid #303437; transform:translateX(-105%); transition:transform .3s ease; display:flex; flex-direction:column; box-shadow:18px 0 50px rgba(0,0,0,.5); }
  body.menu-open .site-menu { transform:translateX(0); }
  body.menu-open .menu-overlay { opacity:1; visibility:visible; }
  .menu-top { display:flex; align-items:center; justify-content:space-between; padding-bottom:24px; border-bottom:1px solid #303437; }
  .menu-top strong { font-size:13px; letter-spacing:3px; }
  .menu-top button { border:0; background:none; color:#fff; font-size:42px; line-height:1; cursor:pointer; }
  .site-menu nav { display:grid; margin-top:18px; }
  .site-menu nav a { display:flex; align-items:center; justify-content:space-between; padding:18px 0; border-bottom:1px solid #25282b; color:#fff; text-decoration:none; font-size:16px; font-weight:900; letter-spacing:1px; }
  .site-menu nav a span { color:#ff1730; font-size:22px; }
  .menu-whatsapp { margin-top:auto; display:flex; align-items:center; justify-content:space-between; padding:15px 17px; border:1px solid #b8ff5a; border-radius:10px; color:#b8ff5a; text-decoration:none; font-size:12px; font-weight:900; letter-spacing:1px; }
  .menu-whatsapp span { font-size:20px; }
  .floating-home { position:fixed; right:18px; bottom:20px; z-index:150; display:flex; align-items:center; gap:7px; padding:10px 13px; border:1px solid #ff1730; border-radius:22px; background:rgba(10,12,14,.94); color:#fff; text-decoration:none; font-size:12px; font-weight:900; letter-spacing:.8px; box-shadow:0 6px 22px rgba(0,0,0,.4),0 0 15px rgba(255,23,48,.16); backdrop-filter:blur(10px); }
  .floating-home:first-letter { color:#ff1730; }
  .floating-home span { color:#fff; }
  .site-footer { display:flex; justify-content:space-between; gap:20px; padding:30px 4%; border-top:1px solid #202326; color:#777; font-size:10px; letter-spacing:2px; text-transform:uppercase; }
  @media(max-width:600px){.site-header{height:82px;padding-left:max(20px,env(safe-area-inset-left));padding-right:max(20px,env(safe-area-inset-right))}.menu-button{width:42px}.menu-button span{width:36px;height:3px}.header-order{padding:14px 19px;border-radius:9px;font-size:13px;white-space:nowrap}.header-order span{font-size:18px}.site-footer{flex-direction:column}}
  @media(max-width:360px){.site-header{height:76px;padding-left:14px;padding-right:14px}.menu-button{width:38px}.menu-button span{width:32px}.header-order{padding:12px 14px;font-size:11px}.header-order span{font-size:16px}}
</style>
<script>
  const menuButton=document.querySelector('#menuButton');
  const menuClose=document.querySelector('#menuClose');
  const menuOverlay=document.querySelector('#menuOverlay');
  function setMenu(open){document.body.classList.toggle('menu-open',open);menuButton?.setAttribute('aria-expanded',String(open));document.querySelector('#siteMenu')?.setAttribute('aria-hidden',String(!open));}
  menuButton?.addEventListener('click',()=>setMenu(true));
  menuClose?.addEventListener('click',()=>setMenu(false));
  menuOverlay?.addEventListener('click',()=>setMenu(false));
  document.querySelectorAll('#siteMenu a').forEach(a=>a.addEventListener('click',()=>setMenu(false)));
</script>
