---
const { title = 'Manchester Sign Shop' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080809" />
    <meta name="description" content="Manchester Sign Shop — signs, lighting and sign-making supplies." />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/manchester-sign-shop/" aria-label="Manchester Sign Shop home">
        <span class="brand-mark">MS</span>
        <span>Manchester Sign Shop</span>
      </a>
      <a class="header-order" href="#estimate">ORDER NOW</a>
    </header>
    <slot />
    <footer class="site-footer">
      <span>MANCHESTER SIGN SHOP</span>
      <span>Signs • Lighting • Supplies</span>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing:border-box; }
  :global(html) { scroll-behavior:smooth; }
  :global(body) {
    margin:0;
    background:#080809;
    color:#f7f7f8;
    font-family:Arial,Helvetica,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .site-header {
    position:sticky;
    top:0;
    z-index:100;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    width:100%;
    padding:14px 4%;
    background:rgba(8,8,9,.82);
    border-bottom:1px solid rgba(255,255,255,.07);
    backdrop-filter:blur(16px);
  }
  .brand {
    display:flex;
    align-items:center;
    gap:10px;
    color:#fff;
    text-decoration:none;
    font-size:13px;
    font-weight:800;
    letter-spacing:.4px;
    text-transform:uppercase;
  }
  .brand-mark {
    display:grid;
    place-items:center;
    width:32px;
    height:32px;
    border-radius:8px;
    background:#e62935;
    color:#fff;
    font-size:11px;
  }
  .header-order {
    color:#fff;
    background:#e62935;
    padding:10px 14px;
    border-radius:5px;
    text-decoration:none;
    font-size:11px;
    font-weight:900;
    letter-spacing:1.2px;
  }
  .site-footer {
    display:flex;
    justify-content:space-between;
    gap:20px;
    padding:28px 4%;
    border-top:1px solid #1c1c20;
    color:#777;
    font-size:10px;
    letter-spacing:1.5px;
    text-transform:uppercase;
  }
  @media(max-width:600px) {
    .brand span:last-child { display:none; }
    .site-header { padding:12px 18px; }
    .site-footer { flex-direction:column; }
  }
</style>
