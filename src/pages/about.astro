---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Manchester Sign Group | Business Signs & Services" description="Meet Manchester Sign Group: business signage, sign-making supplies, sign repairs and lighting fault help, sign cleaning, and installation and fitting for suitable projects.">
  <main class="inner-page">
    <div class="page-head"><small>ABOUT THE GROUP</small><h1>ABOUT <em>US</em></h1><p>Based in Manchester, we make business signs and supply sign-making products across the UK. We also help businesses keep their signs in good shape with repairs, cleaning, and fitting for suitable projects.</p></div>
    <div class="about-grid">
      <div><strong>SIGNS &amp; SUPPLIES</strong><p>Professional business signs, sign-making materials and lighting products, including 3D, RGB, neon, flat signs, printed boards and cut vinyl.</p></div>
      <div><strong>SIGN REPAIRS &amp; LIGHTING FAULTS</strong><p>Help with damaged signs, lighting faults and individual letters that have gone dark.</p></div>
      <div><strong>SIGN CLEANING</strong><p>Refresh your shopfront or business sign with a professional clean.</p></div>
      <div><strong>SIGN INSTALLATION &amp; FITTING</strong><p>Fitting for suitable sign projects, planned around the sign and location.</p></div>
    </div>
  </main>
</Layout>
<style>
  .inner-page{width:min(1000px,92%);margin:auto;padding:70px 0 90px}.page-head{max-width:760px;margin-bottom:35px}.page-head small{color:#ff1730;font-size:11px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(42px,7vw,76px);line-height:.95;letter-spacing:-3px}.page-head h1 em{font-style:normal;color:#ff1730}.page-head p{color:#aaa;line-height:1.6}.about-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.about-grid div{padding:25px;border:1px solid #303437;border-radius:12px;background:#0c0f11}.about-grid strong{font-size:13px;line-height:1.4}.about-grid p{color:#888;font-size:13px;line-height:1.5;margin-bottom:0}@media(max-width:760px){.inner-page{padding:48px 0 65px}.about-grid{grid-template-columns:1fr}}
</style>
