---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About Manchester Sign Group | Sign Makers" description="Learn about Manchester Sign Group, providing business signage, 3D and illuminated signs, printed boards and sign-making supplies across Manchester and Greater Manchester.">
  <main class="inner-page">
    <div class="page-head"><small>ABOUT THE GROUP</small><h1>ABOUT <em>US</em></h1><p>Manchester Sign Group brings signage, supplies and practical sign-making services together in one place.</p></div>
    <div class="about-grid">
      <div><strong>SIGNS</strong><p>From printed boards and cut vinyl to 3D, RGB and neon signage.</p></div>
      <div><strong>SUPPLIES</strong><p>Sign-making materials and lighting products for professionals and businesses.</p></div>
      <div><strong>SUPPORT</strong><p>Clear communication from enquiry through to production and installation.</p></div>
    </div>
  </main>
</Layout>
<style>
  .inner-page{width:min(1000px,92%);margin:auto;padding:70px 0 90px}.page-head{max-width:760px;margin-bottom:35px}.page-head small{color:#ff1730;font-size:11px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(42px,7vw,76px);line-height:.95;letter-spacing:-3px}.page-head h1 em{font-style:normal;color:#ff1730}.page-head p{color:#aaa;line-height:1.6}.about-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.about-grid div{padding:25px;border:1px solid #303437;border-radius:12px;background:#0c0f11}.about-grid strong{font-size:13px}.about-grid p{color:#888;font-size:13px;line-height:1.5}@media(max-width:600px){.inner-page{padding:48px 0 65px}.about-grid{grid-template-columns:1fr}}
</style>