---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact | Manchester Sign Group">
  <main class="inner-page">
    <div class="page-head"><small>GET IN TOUCH</small><h1><em>CONTACT</em> US</h1><p>Tell us what you need and we can discuss your sign, supply or installation requirements.</p></div>
    <div class="contact-grid">
      <a href="https://wa.me/447594106206?text=Hi%20Manchester%2C%20I%20would%20like%20to%20ask%20about%20a%20sign." target="_blank" rel="noopener"><small>WHATSAPP</small><strong>07594 106206</strong><span>Message us →</span></a>
      <a href="tel:+447594106206"><small>PHONE</small><strong>07594 106206</strong><span>Call us →</span></a>
    </div>
  </main>
</Layout>
<style>
  .inner-page{width:min(900px,92%);margin:auto;padding:70px 0 90px}.page-head{margin-bottom:35px}.page-head small{color:#ff1730;font-size:11px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(42px,7vw,76px);line-height:.95;letter-spacing:-3px}.page-head h1 em{font-style:normal;color:#ff1730}.page-head p{color:#aaa;line-height:1.6;max-width:650px}.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.contact-grid a{padding:28px;border:1px solid #303437;border-radius:12px;background:#0c0f11;color:#fff;text-decoration:none}.contact-grid small{display:block;color:#888;font-size:10px;letter-spacing:2px;font-weight:900}.contact-grid strong{display:block;margin:12px 0;font-size:22px}.contact-grid span{color:#ff1730;font-size:11px;font-weight:900}@media(max-width:600px){.inner-page{padding:48px 0 65px}.contact-grid{grid-template-columns:1fr}}
</style>