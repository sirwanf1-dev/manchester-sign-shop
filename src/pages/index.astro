---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { signCategories, shopProducts } from '../data/website.js';
const BASE = '';

const realDir = path.join(process.cwd(), 'public', 'images', 'real-images');
const mediaFiles = fs.existsSync(realDir)
  ? fs.readdirSync(realDir)
      .filter(file => /^hero-\d+\.(?:png|jpe?g|mp4)$/i.test(file))
      .sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}))
  : [];
const heroMedia = mediaFiles.map(file => {
  const isVideo = file.toLowerCase().endsWith('.mp4');
  const optimizedFile = isVideo
    ? file
    : `optimized/${file.replace(/\.(?:png|jpe?g)$/i, '.webp')}`;
  return {
    src: `${BASE}images/real-images/${optimizedFile}`,
    type: isVideo ? 'video' : 'image'
  };
});
const heroImages = heroMedia.length ? heroMedia : signCategories.slice(0,3).map(item => ({src:item.image,type:'image'}));
---

<Layout title="Manchester Sign Makers | 3D, Neon & Shop Signs" description="Manchester-based sign makers supplying 3D, RGB, neon and flat signs, printed boards and sign-making products across the UK, with nationwide delivery and a one-year product warranty.">
  <main>
    <section class="hero">
      <div class="hero-heading">
        <h1>MANCHESTER <em>SIGN</em> GROUP</h1>
        <p>SIGNS <i></i> SUPPLIES <i></i> EVERYTHING YOU NEED</p>
      </div>
      <div class="hero-slider">
        {heroImages.map((media,index)=>(
          <article class:list={['hero-slide',{active:index===0}]} data-slide={index}>
            {media.type === 'video' ? (
              <video src={media.src} autoplay muted loop playsinline preload="metadata" aria-label={`Manchester Sign Group video ${index + 1}`} />
            ) : (
              <img src={media.src} alt={`Manchester Sign Group recent sign work ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : 'low'} />
            )}
            <button class="slider-arrow left" type="button" data-prev aria-label="Previous sign">‹</button>
            <button class="slider-arrow right" type="button" data-next aria-label="Next sign">›</button>
          </article>
        ))}
        <div class="slider-dots">{heroImages.map((_,index)=><button type="button" data-dot={index} aria-label={`Slide ${index+1}`}></button>)}</div>
      </div>
    </section>

    <section class="estimate-section" id="estimate">
      <button class="estimate-toggle" id="estimateToggle" type="button" aria-expanded="false" aria-controls="calculator">
        <span class="estimate-icon" aria-hidden="true"><svg viewBox="0 0 48 48" focusable="false"><rect x="7" y="4" width="34" height="40" rx="5"></rect><rect x="13" y="10" width="22" height="8" rx="2"></rect><path d="M14 24h4M22 24h4M30 24h4M14 31h4M22 31h4M30 31h4M14 38h4M22 38h4M30 38h4"></path></svg></span>
        <span class="estimate-text"><small>INSTANT SIGN ESTIMATE</small><strong>Get an estimated price for your sign.</strong></span>
        <b>›</b>
      </button>
      <div class="calculator" id="calculator" aria-hidden="true">
        <div class="calculator-fields">
          <div class="field"><label>SIGN TYPE</label><select id="signType"><option value="3d">3D Sign</option><option value="rgb">RGB 3D Sign</option><option value="flat">Flat Sign</option><option value="flat">Print on Board</option><option value="sticker">Cut Vinyl Board</option><option value="neon">Neon</option></select></div>
          <div class="field"><label>WIDTH <small>cm</small></label><input id="width" type="number" min="10" step="1" placeholder="Enter width" /></div>
          <div class="field"><label>HEIGHT <small>cm</small></label><input id="height" type="number" min="10" step="1" placeholder="Enter height" /></div>
          <div class="field" id="illuminationField"><label>ILLUMINATION</label><select id="illumination"><option value="none">No illumination</option><option value="led">LED illumination</option><option value="backlit">Backlit</option></select></div>
          <div class="field"><label>INSTALLATION</label><select id="installation"><option value="none">No installation</option><option value="install">Installation</option></select></div>
                  </div>
        <aside class="estimate-summary">
          <span>INDICATIVE STARTING PRICE</span>
          <strong id="estimatePrice">Enter your size</strong>
          <small>Final price is confirmed after reviewing your sign.</small>
          <a class="quote-button" id="quoteButton" href="https://wa.me/447594106206" target="_blank" rel="noopener">SEND MY ESTIMATE →</a>
        </aside>
      </div>
    </section>

    <section class="content-section shop-section" id="shop">
      <div class="section-title-row"><div><h2><em>SHOP</em></h2><p>SIGN MAKING SUPPLIES</p></div><a href="https://wa.me/447594106206?text=Hi%20Manchester%2C%20I%20would%20like%20to%20order%20some%20sign%20making%20materials.%20Please%20let%20me%20know%20what%20you%20need." target="_blank" rel="noopener">ORDER NOW <span>→</span></a></div>
      <div class="shop-grid">{shopProducts.map(item=><article class="shop-card"><img src={item.image} alt={item.title} loading="lazy" /><div class="shop-overlay"><h3>{item.title}</h3></div></article>)}</div>
    </section>

    <section class="benefits">
      <div><b>▱</b><strong>FAST DELIVERY</strong><span>UK WIDE</span></div>
      <div><b>♢</b><strong>QUALITY PRODUCTS</strong><span>TRUSTED BRANDS</span></div>
      <div><b>▤</b><strong>SECURE PAYMENT</strong><span>SAFE & EASY</span></div>
      <div><b>♧</b><strong>EXPERT SUPPORT</strong><span>WE'RE HERE TO HELP</span></div>
    </section>

  </main>
</Layout>

<script>
  const slides=[...document.querySelectorAll('[data-slide]')],dots=[...document.querySelectorAll('[data-dot]')];
  let active=0,timer;
  function show(i){active=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('active',n===active));dots.forEach((d,n)=>d.classList.toggle('active',n===active));}
  function restart(){clearInterval(timer);timer=setInterval(()=>show(active+1),5000);}
  document.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();show(active+1);restart()}));
  document.querySelectorAll('[data-prev]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();show(active-1);restart()}));
  dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);restart()})); if(slides.length){show(0);restart()}

  const toggle=document.querySelector('#estimateToggle'),calc=document.querySelector('#calculator');
  toggle?.addEventListener('click',()=>{const open=calc.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));calc.setAttribute('aria-hidden',String(!open))});
  const type=document.querySelector('#signType'),width=document.querySelector('#width'),height=document.querySelector('#height'),illumination=document.querySelector('#illumination'),installation=document.querySelector('#installation'),output=document.querySelector('#estimatePrice');
  const rates={flat:.0004,sticker:.00028,'3d':.00075,neon:.0009,rgb:.0009},minimums={flat:150,sticker:105,'3d':250,neon:300,rgb:300};
  function billableDimension(cm){
    if(cm<=50) return 50;
    if(cm<=100) return 100;
    return cm;
  }
  function roundEstimate(price){
    if(price<=1000) return Math.round(price/10)*10;
    return Math.round(price/100)*100-1;
  }
  function calculate(){
    const widthCm=Number(width?.value||0),heightCm=Number(height?.value||0);
    if(!widthCm||!heightCm){if(output)output.textContent='Enter your size';return;}
    const billableWidth=billableDimension(widthCm);
    const billableHeight=billableDimension(heightCm);
    const area=billableWidth*billableHeight*100;
    const illuminationFactor=type?.value==='neon'?0.4:(illumination?.value==='none'?0.65:((type?.value==='3d'||type?.value==='rgb')?0.78:1));
    const installationCost=installation?.value==='install'?(type?.value==='neon'?100:400):0;
    const unitPrice=Math.max(minimums[type?.value],Math.round(area*rates[type?.value]*illuminationFactor));
    const price=roundEstimate(unitPrice+installationCost);
    if(output)output.textContent=`£${price.toLocaleString('en-GB')}`;
  }
  [type,width,height,illumination,installation].forEach(el=>el?.addEventListener('input',calculate));
  function updateEstimatorOptions(){const noIllumination=['neon','flat','sticker'].includes(type?.value);const field=document.querySelector('#illuminationField');if(field)field.style.display=noIllumination?'none':'';if(noIllumination&&illumination)illumination.value='none';calculate();}
  type?.addEventListener('change',updateEstimatorOptions);updateEstimatorOptions();

  const quoteButton=document.querySelector('#quoteButton');
  quoteButton?.addEventListener('click',()=>{
    const signTypeLabel=type?.options[type.selectedIndex]?.text || 'Sign';
    const illuminationLabel=illumination?.options[illumination.selectedIndex]?.text || 'No illumination';
    const installationLabel=installation?.options[installation.selectedIndex]?.text || 'No installation';
    const price=output?.textContent || '£0';
    const message=[
      'Hi Manchester,',
      '',
      'SIGN QUOTE',
      `Type: ${signTypeLabel}`,
      `Size: ${width?.value || 0} × ${height?.value || 0} cm`,
      `Lighting: ${illuminationLabel}`,
      `Installation: ${installationLabel}`,
      `Estimated price: ${price}`,
      '',
      'Please confirm the quote. Thank you.'
    ].join('\n');
    quoteButton.href=`https://wa.me/447594106206?text=${encodeURIComponent(message)}`;
  });

  function setupCardSlider(selector){
    const rail=document.querySelector(selector);
    if(!rail) return;
    const cards=[...rail.children];
    if(cards.length<3) return;
    let position=0;
    let timer;
    const step=()=>cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(rail).gap || '0');
    const max=()=>Math.max(0,cards.length-2);
    function move(){
      position = position >= max() ? 0 : position + 1;
      rail.scrollTo({left: position * step(), behavior:'smooth'});
    }
    function start(){clearInterval(timer);timer=setInterval(move,3000);}
    rail.addEventListener('touchstart',()=>clearInterval(timer),{passive:true});
    rail.addEventListener('touchend',start,{passive:true});
    window.addEventListener('resize',()=>{
      position=0;
      rail.scrollTo({left:0,behavior:'auto'});
      start();
    });
    start();
  }

  if(window.matchMedia('(max-width:760px)').matches){
    setupCardSlider('.shop-grid');
  }
</script>

<style>
  :global(*){box-sizing:border-box}
  :global(html){width:100%;overflow-x:hidden;-webkit-text-size-adjust:100%}
  :global(body){width:100%;max-width:100%;overflow-x:hidden;background:#050708}
  :global(img),:global(video){max-width:100%}
  :global(button),:global(input),:global(select){font:inherit}
  main{width:100%;max-width:100%;overflow:hidden}
  .hero{width:min(1200px,94%);margin:auto;padding:20px 0 32px}.hero-heading{text-align:center;padding:0 0 18px}
  h1{margin:0;font-size:clamp(42px,7vw,82px);line-height:.95;letter-spacing:-4px;font-weight:950;white-space:nowrap}h1 em,.section-title-row h2 em,.shop-section h2 em{font-style:normal;color:#ff1730}
  .hero-heading p{margin:12px 0 0;color:#ddd;font-size:14px;letter-spacing:7px;font-weight:700}.hero-heading i{display:inline-block;width:3px;height:16px;margin:0 13px;background:#ff1730;vertical-align:-3px}
  .hero-slider{position:relative;aspect-ratio:16/9;border:1px solid #34383c;border-radius:18px;overflow:hidden;background:#121518}.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity .5s}.hero-slide.active{opacity:1}.hero-slide img,.hero-slide video{width:100%;height:100%;display:block;object-fit:cover}
  .slider-arrow{position:absolute;top:50%;transform:translateY(-50%);width:58px;height:58px;border:2px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(0,0,0,.4);color:#fff;font-size:50px;line-height:45px;cursor:pointer}.slider-arrow.left{left:18px}.slider-arrow.right{right:18px}
  .slider-dots{position:absolute;left:50%;bottom:15px;transform:translateX(-50%);display:flex;gap:10px;padding:8px 15px;border-radius:20px;background:rgba(0,0,0,.7)}.slider-dots button{width:15px;height:15px;border:0;border-radius:50%;background:#555;cursor:pointer}.slider-dots button.active{background:#ff1730}
  .content-section{width:min(1200px,94%);margin:auto;padding:20px 0 34px}.section-title-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:16px}.section-title-row h2{margin:0;font-size:clamp(32px,5vw,54px);letter-spacing:-2px;line-height:1}
  .section-title-row a{border:2px solid #ff1730;border-radius:28px;padding:12px 20px;color:#fff;text-decoration:none;font-size:12px;font-weight:900;letter-spacing:.5px;box-shadow:0 0 18px rgba(255,23,48,.16)}.section-title-row a span{color:#ff1730;font-size:18px;margin-left:6px}
  .shop-section .section-title-row{align-items:end}.shop-section h2{margin:0}.shop-section h2 em{color:#b8ff5a}.shop-section p{margin:7px 0 0;color:#eee;letter-spacing:4px;font-size:12px;font-weight:800}
  .shop-section .section-title-row a{border-color:#b8ff5a;box-shadow:0 0 18px rgba(184,255,90,.18)}
  .shop-section .section-title-row a span{color:#b8ff5a}
  .shop-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}.shop-card{min-width:0}
  .shop-card{position:relative;aspect-ratio:1/1.05;border:1px solid #4a4e52;border-radius:13px;overflow:hidden;background:#15191b}.shop-card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s}.shop-card:hover img{transform:scale(1.05)}
  .shop-overlay{position:absolute;inset:0;background:linear-gradient(transparent 40%,rgba(0,0,0,.85) 100%)}.shop-overlay h3{position:absolute;bottom:14px;left:16px;right:10px;margin:0;color:#fff;font-size:15px;font-weight:900;text-transform:uppercase}
  .estimate-section{width:min(1120px,92%);margin:5px auto 20px;padding:3px;border:2px solid #ff1730;border-radius:20px;background:linear-gradient(110deg,#ff1730,#b00018 55%,#ff1730);box-shadow:0 0 35px rgba(255,23,48,.28)}
  .estimate-toggle{width:100%;display:grid;grid-template-columns:85px 1fr 45px;align-items:center;gap:18px;padding:25px 42px;border:0;border-radius:16px;background:#9d071a;color:#fff;text-align:left;cursor:pointer}.estimate-icon{display:flex;align-items:center;justify-content:center;color:#fff}.estimate-icon svg{width:52px;height:52px;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.estimate-text{display:grid;gap:8px}.estimate-text small{font-size:12px;letter-spacing:4px;font-weight:800}.estimate-text strong{font-size:30px;line-height:1.05}.estimate-toggle>b{font-size:52px;font-weight:300;text-align:center;transition:transform .3s}.estimate-toggle[aria-expanded=true]>b{transform:rotate(90deg)}
  .calculator{display:none;grid-template-columns:minmax(0,1fr) 250px;gap:18px;padding:18px;background:#0b0d0e;border-radius:0 0 16px 16px;align-items:stretch}.calculator.open{display:grid}.calculator-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.field{display:grid;gap:6px;min-width:0}.field label{font-size:9px;color:#999;font-weight:900;letter-spacing:1.5px}.field label small{color:#ff1730;font-size:9px}.field input,.field select{width:100%;min-width:0;padding:12px 13px;border:1px solid #303437;background:#15191b;color:#fff;border-radius:6px;font-size:14px}.field input:focus,.field select:focus{outline:2px solid rgba(255,23,48,.55);border-color:#ff1730}.estimate-summary{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:18px;border:1px solid #3a3d40;border-radius:12px;background:linear-gradient(145deg,#16191b,#0b0d0e)}.estimate-summary>span{font-size:9px;color:#999;letter-spacing:2px;font-weight:900}.estimate-summary strong{display:block;color:#ff1730;font-size:36px;line-height:1.05;margin:7px 0}.estimate-summary small{color:#777;font-size:10px;line-height:1.4}.quote-button{display:flex;align-items:center;justify-content:center;min-height:46px;margin-top:16px;padding:12px;background:#ff1730;color:#fff;text-decoration:none;font-size:11px;font-weight:900;letter-spacing:1.3px;border-radius:7px;box-shadow:0 0 18px rgba(255,23,48,.16)}
  .shop-section{padding-top:12px}.shop-card{aspect-ratio:1/.98}.shop-overlay{background:linear-gradient(transparent 45%,rgba(0,0,0,.9) 100%)}
  .benefits{width:min(1200px,94%);margin:0 auto;padding:34px 0 25px;border-top:1px solid #303437;display:grid;grid-template-columns:repeat(4,1fr)}.benefits div{display:grid;grid-template-columns:42px 1fr;column-gap:10px;padding:0 25px;border-right:1px solid #303437}.benefits div:last-child{border:0}.benefits b{grid-row:span 2;color:#ff1730;font-size:30px}.benefits strong{font-size:12px}.benefits span{color:#888;font-size:10px;margin-top:3px}
  @media(max-width:1024px){
    .hero{width:min(1200px,96%)}.content-section,.benefits{width:min(1200px,96%)}
    .shop-grid{grid-template-columns:repeat(3,1fr)}
    .estimate-section{width:min(1120px,94%)}
  }
  @media(max-width:760px){
    :global(body){background:#050708}
    .hero{width:100%;margin:0;padding:14px 0 22px}.hero-heading{text-align:center;padding:0 max(12px,env(safe-area-inset-left)) 14px}
    h1{font-size:clamp(24px,7.2vw,31px);line-height:1;letter-spacing:.4px;white-space:nowrap}
    .hero-heading p{margin-top:10px;font-size:clamp(7px,2.1vw,9px);letter-spacing:clamp(1.8px,2.5vw,2.8px);line-height:1.4;white-space:nowrap;text-align:center}
    .hero-heading i{height:9px;width:2px;margin:0 5px}
    .hero-slider{width:100%;aspect-ratio:16/9;border-radius:0;border-left:0;border-right:0}.hero-slide img,.hero-slide video{object-position:center}
    .slider-arrow{width:40px;height:40px;font-size:34px;line-height:30px;background:rgba(0,0,0,.55)}.slider-arrow.left{left:10px}.slider-arrow.right{right:10px}
    .slider-dots{bottom:10px;gap:6px;padding:6px 10px}.slider-dots button{width:8px;height:8px}
    .content-section{width:100%;padding:25px 0 28px}.section-title-row{align-items:flex-end;gap:12px;margin:0 16px 14px}.section-title-row h2{font-size:clamp(27px,8vw,34px);letter-spacing:-1.5px}.section-title-row a{padding:8px 11px;border-radius:20px;font-size:8px;white-space:nowrap}
    .shop-grid{display:flex !important;flex-wrap:nowrap !important;gap:10px;width:100%;padding:0 16px 8px;overflow-x:auto !important;overflow-y:hidden !important;scroll-behavior:smooth;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none}.shop-grid::-webkit-scrollbar{display:none}
    .shop-card{flex:0 0 calc((100% - 42px) / 2) !important;width:calc((100% - 42px) / 2) !important;min-width:0 !important;height:auto !important;transform:none !important;scroll-snap-align:start;display:block !important;aspect-ratio:1.18/1 !important;border-radius:10px}
    .shop-overlay h3{left:9px;bottom:8px;font-size:clamp(9px,2.5vw,11px)}.shop-card img{transform:scale(1) !important;object-fit:cover}
    .estimate-section{width:calc(100% - 32px);margin:3px 16px 22px;border-radius:14px;padding:2px}.estimate-toggle{grid-template-columns:38px minmax(0,1fr) 25px;gap:9px;padding:16px 14px;border-radius:11px}.estimate-icon svg{width:30px;height:30px}.estimate-text{gap:5px;min-width:0}.estimate-text small{font-size:clamp(6px,1.8vw,8px);letter-spacing:1.6px}.estimate-text strong{font-size:clamp(14px,4.3vw,17px);line-height:1.15}.estimate-toggle>b{font-size:32px}.calculator{grid-template-columns:1fr;gap:12px;padding:13px}.calculator-fields{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.estimate-summary{padding:15px}.field input,.field select{min-height:46px;font-size:16px}.quote-button{min-height:48px;display:flex;align-items:center;justify-content:center}
    .shop-section{padding-top:8px}.shop-section .section-title-row{align-items:center}.shop-section .section-title-row a{min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;font-size:10px;text-align:center}.shop-section p{margin-top:5px;font-size:clamp(7px,2vw,9px);letter-spacing:2.2px}
    .benefits{width:100%;padding:18px 10px 14px;grid-template-columns:repeat(4,minmax(0,1fr));gap:0}.benefits div{min-height:42px;padding:6px 3px;display:flex;align-items:center;justify-content:center;gap:4px;border-right:1px solid #303437;border-bottom:0;text-align:center}.benefits div:last-child{border-right:0}.benefits b{font-size:13px;line-height:1;flex:0 0 auto}.benefits strong{font-size:clamp(6px,1.8vw,8px);line-height:1;white-space:nowrap;letter-spacing:.1px}.benefits span{display:none}
  }
  @media(max-width:360px){
    .site-header{padding:0 14px}
    .header-order{padding:12px 14px;font-size:11px}
    .header-order span{font-size:16px}
    .menu-button span{width:32px}
    .hero-heading{padding-left:8px;padding-right:8px}
    h1{font-size:23px;letter-spacing:0}
    .hero-heading p{font-size:6.8px;letter-spacing:1.5px}
    .section-title-row{margin-left:12px;margin-right:12px}
    .shop-grid{padding-left:12px;padding-right:12px}
    .shop-card{flex-basis:calc((100% - 34px) / 2) !important;width:calc((100% - 34px) / 2) !important}
    .estimate-section{width:calc(100% - 24px);margin-left:12px;margin-right:12px}
    .estimate-toggle{grid-template-columns:32px minmax(0,1fr) 20px;padding-left:10px;padding-right:10px}
    .estimate-text small{letter-spacing:1px}
    .estimate-text strong{font-size:13px}
    .calculator-fields .field:first-child{grid-column:1/-1}
    .shop-section .section-title-row a{font-size:9px;padding-left:10px;padding-right:10px}
  }
  @media(min-width:761px) and (max-width:1100px){
    .site-header{height:88px}
    .header-order{padding:15px 23px;font-size:14px}
    .estimate-toggle{grid-template-columns:68px minmax(0,1fr) 38px;padding:22px 28px}
    .estimate-text strong{font-size:26px}
    .benefits div{padding:0 14px}
  }
</style>
