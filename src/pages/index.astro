---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { signCategories } from '../data/website.js';
import serviceImages from '../data/service-images.json';
import { supabase } from '../lib/supabase.js';
const BASE = '';
const serviceImageSrcset = image => `${image.replace(/\.webp$/i, '-640.webp')} 640w, ${image} 1200w`;

const realDir = path.join(process.cwd(), 'public', 'images', 'real-images');
const mediaFiles = fs.existsSync(realDir)
  ? fs.readdirSync(realDir)
      .filter(file => /^hero-\d+\.(?:png|jpe?g|mp4)$/i.test(file))
      .sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}))
  : [];
const heroMedia = mediaFiles.map(file => {
  const isVideo = file.toLowerCase().endsWith('.mp4');
  const optimizedFile = isVideo
    ? file
    : `optimized/${file.replace(/\.(?:png|jpe?g)$/i, '.webp')}`;
  const src = `${BASE}images/real-images/${optimizedFile}`;
  const baseName = file.replace(/\.(?:png|jpe?g)$/i, '');
  const srcSet = isVideo ? undefined : [800, 1200, 1600]
    .map(width => {
      const suffix = width === 1600 ? '' : `-${width}`;
      return `${BASE}images/real-images/optimized/${baseName}${suffix}.webp ${width}w`;
    })
    .join(', ');
  return { src, srcSet, type: isVideo ? 'video' : 'image' };
});
const heroImages = heroMedia.length ? heroMedia : signCategories.slice(0,3).map(item => ({src:item.image,type:'image'}));
---

<Layout title="Professional Business Sign Makers | Manchester Sign Group" description="Professional 3D, illuminated and shop signs for businesses. Made in Manchester, delivered across the UK.">
  <main>
    <section class="hero">
      <div class="hero-heading">
        <h1>MANCHESTER <em>SIGN</em> GROUP</h1>
        <p>SIGNS <i></i> SUPPLIES <i></i> EVERYTHING YOU NEED</p>
      </div>
      <div class="hero-slider">
        {heroImages.map((media,index)=>(
          <article class:list={['hero-slide',{active:index===0}]} data-slide={index}>
            {media.type === 'video' ? (
              <video src={media.src} autoplay muted loop playsinline preload="metadata" aria-label={`Manchester Sign Group video ${index + 1}`} />
            ) : (
              <img src={media.src} srcset={media.srcSet} sizes="(min-width: 1277px) 1200px, 94vw" alt={`Manchester Sign Group recent sign work ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={index === 0 ? 'high' : 'low'} />
            )}
            <button class="slider-arrow left" type="button" data-prev aria-label="Previous sign">‹</button>
            <button class="slider-arrow right" type="button" data-next aria-label="Next sign">›</button>
          </article>
        ))}
        <div class="slider-dots">{heroImages.map((_,index)=><button type="button" data-dot={index} aria-label={`Slide ${index+1}`}></button>)}</div>
      </div>
    </section>

    <section class="estimate-section" id="estimate">
      <button class="estimate-toggle" id="estimateToggle" type="button" aria-expanded="false" aria-controls="calculator">
        <span class="estimate-icon" aria-hidden="true"><svg viewBox="0 0 48 48" focusable="false"><rect x="7" y="4" width="34" height="40" rx="5"></rect><rect x="13" y="10" width="22" height="8" rx="2"></rect><path d="M14 24h4M22 24h4M30 24h4M14 31h4M22 31h4M30 31h4M14 38h4M22 38h4M30 38h4"></path></svg></span>
        <span class="estimate-text"><small>INSTANT SIGN ESTIMATE</small><strong>Get an estimated price for your sign.</strong></span>
        <b>›</b>
      </button>
      <div class="calculator" id="calculator" aria-hidden="true">
        <div class="calculator-fields">
          <div class="field"><label>SIGN TYPE</label><select id="signType"><option value="3d">3D Sign</option><option value="rgb">RGB 3D Sign</option><option value="flat">Flat Sign</option><option value="flat">Print on Board</option><option value="sticker">Cut Vinyl Board</option><option value="neon">Neon</option></select></div>
          <div class="field"><label>WIDTH <small>cm</small></label><input id="width" type="number" min="10" step="1" placeholder="Enter width" /></div>
          <div class="field"><label>HEIGHT <small>cm</small></label><input id="height" type="number" min="10" step="1" placeholder="Enter height" /></div>
          <div class="field" id="illuminationField"><label>ILLUMINATION</label><select id="illumination"><option value="none">No illumination</option><option value="led">LED illumination</option><option value="backlit">Backlit</option></select></div>
          <div class="field"><label>INSTALLATION</label><select id="installation"><option value="none">No installation</option><option value="install">Installation</option></select></div>
                  </div>
        <aside class="estimate-summary">
          <span>ESTIMATED PRICE · 10% OFF SIGNS</span>
          <strong id="estimatePrice">Enter your size</strong>
          <small>Includes 10% off the sign price. Installation is added separately when selected.</small>
          <a class="quote-button" id="quoteButton" href="https://wa.me/447594106206" target="_blank" rel="noopener">SEND MY ESTIMATE →</a>
        </aside>
      </div>
    </section>

    <section class="content-section other-services-section" id="other-services" data-service-gallery>
      <div class="section-title-row"><div><h2><em>OTHER SERVICES</em></h2><p>REPAIRS • CLEANING • INSTALLATION</p></div><a href="/other-services/">VIEW SERVICES <span>→</span></a></div>
      <p class="service-gallery-intro">Explore our sign repair, cleaning and installation services.</p>
      <div class="other-services-scrollspace" data-service-scrollspace>
        <div class="other-services-stage" data-service-stage>
          <div class="other-services-rail" data-service-rail role="region" tabindex="0" aria-label="Other sign services. Scroll or swipe to explore.">
            <a class="other-service-card" data-service-panel href="/other-services/">
              <img src={serviceImages.repair} srcset={serviceImageSrcset(serviceImages.repair)} sizes="(max-width: 760px) 86vw, (max-width: 1200px) 82vw, 1000px" data-service-image="repair" alt="MASON 3D sign with one unlit letter, showing a sign repair" loading="lazy" decoding="async" />
              <div class="other-service-overlay"><small>01 / REPAIR</small><h3>SIGN REPAIRS</h3><p>One letter gone dark? We can help.</p></div>
            </a>
            <a class="other-service-card" data-service-panel href="/other-services/">
              <img src={serviceImages.cleaning} srcset={serviceImageSrcset(serviceImages.cleaning)} sizes="(max-width: 760px) 86vw, (max-width: 1200px) 82vw, 1000px" data-service-image="cleaning" alt="A sign cleaner wiping grime from raised shop sign letters" loading="lazy" decoding="async" />
              <div class="other-service-overlay"><small>02 / CLEANING</small><h3>SIGN CLEANING</h3><p>Bring back a clean, bright finish.</p></div>
            </a>
            <a class="other-service-card" data-service-panel href="/other-services/">
              <img src={serviceImages.installation} srcset={serviceImageSrcset(serviceImages.installation)} sizes="(max-width: 760px) 86vw, (max-width: 1200px) 82vw, 1000px" data-service-image="installation" alt="Illustrative photo of an installer fitting an NHS sign at a health centre" loading="lazy" decoding="async" />
              <div class="other-service-overlay"><small>03 / INSTALLATION</small><h3>SIGN INSTALLATION</h3><p>Professional fitting for suitable sign projects.</p></div>
            </a>
          </div>
          <div class="service-gallery-hud" aria-hidden="true">
            <span class="gallery-hint-scroll">SCROLL TO EXPLORE</span>
            <span class="gallery-hint-sideways">SCROLL SIDEWAYS</span>
            <span class="gallery-hint-swipe">SWIPE TO EXPLORE</span>
            <span class="gallery-progress"><i data-service-progress></i></span>
            <strong><span data-service-current>01</span> / 03</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="benefits">
      <div><b>▱</b><strong>FAST DELIVERY</strong><span>DELIVERY THROUGHOUT THE UNITED KINGDOM</span></div>
      <div><b>♢</b><strong>QUALITY PRODUCTS</strong><span>TRUSTED BRANDS</span></div>
      <div><b>▤</b><strong>SECURE PAYMENT</strong><span>SAFE & EASY</span></div>
      <div><b>♧</b><strong>EXPERT SUPPORT</strong><span>WE'RE HERE TO HELP</span></div>
    </section>

  </main>
</Layout>

<script>
  const heroSlider=document.querySelector('.hero-slider');
  async function appendUploadedSlides(){
    const {data,error}=await supabase.storage.from('website-images').list('slides',{limit:1000,sortBy:{column:'name',order:'asc'}});
    if(error||!data?.length||!heroSlider) return;
    const dotRail=heroSlider.querySelector('.slider-dots');
    data.filter(file=>/\.(?:jpe?g|png|webp)$/i.test(file.name)).forEach(file=>{
      const slide=document.createElement('article');
      slide.className='hero-slide';
      slide.dataset.slide='';
      const image=document.createElement('img');
      image.src=supabase.storage.from('website-images').getPublicUrl('slides/'+file.name).data.publicUrl;
      image.alt='Manchester Sign Group sign project';
      image.loading='lazy';
      image.decoding='async';
      const previous=document.createElement('button');
      previous.className='slider-arrow left';
      previous.type='button';
      previous.dataset.prev='';
      previous.setAttribute('aria-label','Previous sign');
      previous.textContent='‹';
      const next=document.createElement('button');
      next.className='slider-arrow right';
      next.type='button';
      next.dataset.next='';
      next.setAttribute('aria-label','Next sign');
      next.textContent='›';
      slide.append(image,previous,next);
      heroSlider.insertBefore(slide,dotRail);
    });
  }
  async function initializeHeroSlider(){
    try{await appendUploadedSlides()}catch(error){console.warn('Could not load uploaded slideshow photos:',error.message)}
    const slides=[...document.querySelectorAll('[data-slide]')];
    const dotRail=document.querySelector('.slider-dots');
    if(!slides.length||!dotRail) return;
    dotRail.replaceChildren();
    slides.forEach((slide,index)=>{
      slide.dataset.slide=String(index);
      const dot=document.createElement('button');
      dot.type='button';
      dot.dataset.dot=String(index);
      dot.setAttribute('aria-label','Slide '+(index+1));
      dotRail.append(dot);
    });
    const dots=[...dotRail.querySelectorAll('[data-dot]')];
    let active=0,timer;
    function show(index){
      active=(index+slides.length)%slides.length;
      slides.forEach((slide,n)=>slide.classList.toggle('active',n===active));
      dots.forEach((dot,n)=>dot.classList.toggle('active',n===active));
    }
    function restart(){clearInterval(timer);timer=setInterval(()=>show(active+1),5000)}
    document.querySelectorAll('[data-next]').forEach(button=>button.addEventListener('click',event=>{event.stopPropagation();show(active+1);restart()}));
    document.querySelectorAll('[data-prev]').forEach(button=>button.addEventListener('click',event=>{event.stopPropagation();show(active-1);restart()}));
    dots.forEach((dot,index)=>dot.addEventListener('click',()=>{show(index);restart()}));
    show(0);
    restart();
  }
  initializeHeroSlider();

  async function loadUploadedServicePhotos(){
    const {data,error}=await supabase.storage.from('website-images').list('services',{limit:1000,sortBy:{column:'name',order:'asc'}});
    if(error||!data) return;
    const latest={};
    const files=data
      .filter(file=>/\.(?:jpe?g|png|webp)$/i.test(file.name))
      .sort((a,b)=>new Date(b.updated_at||b.created_at||0)-new Date(a.updated_at||a.created_at||0));
    files.forEach(file=>{
      const key=['repair','cleaning','installation'].find(service=>file.name.startsWith(service+'-'));
      if(key&&!latest[key]) latest[key]=file;
    });
    document.querySelectorAll('[data-service-image]').forEach(image=>{
      const file=latest[image.dataset.serviceImage];
      if(file){
        image.removeAttribute('srcset');
        image.removeAttribute('sizes');
        image.src=supabase.storage.from('website-images').getPublicUrl('services/'+file.name).data.publicUrl;
      }
    });
  }
  loadUploadedServicePhotos().catch(error=>console.warn('Could not load uploaded service photos:',error.message));

  const toggle=document.querySelector('#estimateToggle'),calc=document.querySelector('#calculator');
  toggle?.addEventListener('click',()=>{const open=calc.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));calc.setAttribute('aria-hidden',String(!open))});
  const type=document.querySelector('#signType'),width=document.querySelector('#width'),height=document.querySelector('#height'),illumination=document.querySelector('#illumination'),installation=document.querySelector('#installation'),output=document.querySelector('#estimatePrice');
  const rates={flat:.0004,sticker:.00028,'3d':.00075,neon:.0009,rgb:.0009},minimums={flat:150,sticker:105,'3d':250,neon:300,rgb:300};
  function billableDimension(cm){
    if(cm<=50) return 50;
    if(cm<=100) return 100;
    return cm;
  }
  function roundEstimate(price){
    if(price<=1000) return Math.round(price/10)*10;
    return Math.round(price/100)*100-1;
  }
  function calculate(){
    const widthCm=Number(width?.value||0),heightCm=Number(height?.value||0);
    if(!widthCm||!heightCm){if(output)output.textContent='Enter your size';return;}
    const billableWidth=billableDimension(widthCm);
    const billableHeight=billableDimension(heightCm);
    const area=billableWidth*billableHeight*100;
    const illuminationFactor=type?.value==='neon'?0.4:(illumination?.value==='none'?0.65:((type?.value==='3d'||type?.value==='rgb')?0.78:1));
    const installationCost=installation?.value==='install'?(type?.value==='neon'?100:400):0;
    const unitPrice=Math.max(minimums[type?.value],Math.round(area*rates[type?.value]*illuminationFactor));
    const discountedSignPrice=unitPrice*0.9;
    const price=roundEstimate(discountedSignPrice+installationCost);
    if(output)output.textContent=`£${price.toLocaleString('en-GB')}`;
  }
  [type,width,height,illumination,installation].forEach(el=>el?.addEventListener('input',calculate));
  function updateEstimatorOptions(){const noIllumination=['neon','flat','sticker'].includes(type?.value);const field=document.querySelector('#illuminationField');if(field)field.style.display=noIllumination?'none':'';if(noIllumination&&illumination)illumination.value='none';calculate();}
  type?.addEventListener('change',updateEstimatorOptions);updateEstimatorOptions();

  const quoteButton=document.querySelector('#quoteButton');
  quoteButton?.addEventListener('click',()=>{
    const signTypeLabel=type?.options[type.selectedIndex]?.text || 'Sign';
    const illuminationLabel=illumination?.options[illumination.selectedIndex]?.text || 'No illumination';
    const installationLabel=installation?.options[installation.selectedIndex]?.text || 'No installation';
    const price=output?.textContent || '£0';
    const message=[
      'Hi Manchester,',
      '',
      'SIGN QUOTE',
      `Type: ${signTypeLabel}`,
      `Size: ${width?.value || 0} × ${height?.value || 0} cm`,
      `Lighting: ${illuminationLabel}`,
      `Installation: ${installationLabel}`,
      `Estimated price: ${price}`,
      '',
      'Please confirm the quote. Thank you.'
    ].join('\n');
    quoteButton.href=`https://wa.me/447594106206?text=${encodeURIComponent(message)}`;
  });

  function initializeOtherServiceGallery(){
    const gallery=document.querySelector('[data-service-gallery]');
    const scrollspace=gallery?.querySelector('[data-service-scrollspace]');
    const stage=gallery?.querySelector('[data-service-stage]');
    const rail=gallery?.querySelector('[data-service-rail]');
    const cards=[...gallery?.querySelectorAll('[data-service-panel]')||[]];
    const progressBar=gallery?.querySelector('[data-service-progress]');
    const currentLabel=gallery?.querySelector('[data-service-current]');
    if(!gallery||!scrollspace||!stage||!rail||!cards.length) return;

    const mobile=window.matchMedia('(max-width:760px)');
    const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame=0;

    function update(){
      frame=0;
      const scrollDriven=gallery.classList.contains('is-scroll-driven');
      let progress=0;
      let centerWidth=rail.clientWidth;
      let travelX=Math.max(0,rail.scrollWidth-centerWidth);

      if(scrollDriven){
        const pageTop=scrollspace.getBoundingClientRect().top+window.scrollY;
        const stickyTop=parseFloat(getComputedStyle(stage).top)||0;
        const travelY=Math.max(1,scrollspace.offsetHeight-stage.offsetHeight);
        progress=Math.min(1,Math.max(0,(window.scrollY-(pageTop-stickyTop))/travelY));
        travelX=Math.max(0,rail.scrollWidth-stage.clientWidth);
        rail.style.transform=`translate3d(${-travelX*progress}px,0,0)`;
        centerWidth=stage.clientWidth;
      }else{
        progress=travelX?Math.min(1,Math.max(0,rail.scrollLeft/travelX)):0;
      }

      const center=centerWidth/2;
      let nearest=0;
      let nearestDistance=Number.POSITIVE_INFINITY;
      cards.forEach((card,index)=>{
        const position=(scrollDriven?rail.offsetLeft:0)+card.offsetLeft+card.offsetWidth/2-(scrollDriven?travelX*progress:rail.scrollLeft);
        const offset=position-center;
        const distance=Math.abs(offset);
        if(distance<nearestDistance){nearestDistance=distance;nearest=index;}

        if(!mobile.matches&&!reducedMotion.matches){
          const normalized=Math.max(-1,Math.min(1,offset/Math.max(1,centerWidth*.82)));
          const depth=Math.min(1.2,Math.abs(normalized));
          const tilt=normalized*11;
          const scale=1-depth*.075;
          card.style.transform=`translateZ(${-depth*72}px) rotateY(${tilt}deg) scale(${scale})`;
        }
      });

      if(progressBar) progressBar.style.transform=`scaleX(${progress})`;
      if(currentLabel) currentLabel.textContent=String(nearest+1).padStart(2,'0');
    }

    function scheduleUpdate(){
      if(!frame) frame=requestAnimationFrame(update);
    }

    function setGalleryMode(){
      const scrollDriven=!mobile.matches&&!reducedMotion.matches;
      gallery.classList.toggle('is-scroll-driven',scrollDriven);
      rail.style.removeProperty('transform');
      if(scrollDriven) window.addEventListener('scroll',scheduleUpdate,{passive:true});
      else window.removeEventListener('scroll',scheduleUpdate);
      if(!scrollDriven) cards.forEach(card=>card.style.removeProperty('transform'));
      scheduleUpdate();
    }

    rail.addEventListener('scroll',scheduleUpdate,{passive:true});
    window.addEventListener('resize',setGalleryMode,{passive:true});
    mobile.addEventListener('change',setGalleryMode);
    reducedMotion.addEventListener('change',setGalleryMode);
    setGalleryMode();
  }
  initializeOtherServiceGallery();
</script>

<style>
  :global(*){box-sizing:border-box}
  :global(html){width:100%;overflow-x:clip;-webkit-text-size-adjust:100%}
  :global(body){width:100%;max-width:100%;overflow-x:clip;background:#050708}
  :global(img),:global(video){max-width:100%}
  :global(button),:global(input),:global(select){font:inherit}
  main{width:100%;max-width:100%;overflow-x:clip}
  .hero{width:min(1200px,94%);margin:auto;padding:20px 0 32px}.hero-heading{text-align:center;padding:0 0 18px}
  h1{margin:0;font-size:clamp(42px,7vw,82px);line-height:.95;letter-spacing:-4px;font-weight:950;white-space:nowrap}h1 em,.section-title-row h2 em,.other-services-section h2 em{font-style:normal;color:#ff1730}
  .hero-heading p{margin:12px 0 0;color:#ddd;font-size:14px;letter-spacing:7px;font-weight:700}.hero-heading i{display:inline-block;width:3px;height:16px;margin:0 13px;background:#ff1730;vertical-align:-3px}
  .hero-slider{position:relative;aspect-ratio:16/9;border:1px solid #34383c;border-radius:18px;overflow:hidden;background:#121518}.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity .5s}.hero-slide.active{opacity:1}.hero-slide img,.hero-slide video{width:100%;height:100%;display:block;object-fit:cover}
  .slider-arrow{position:absolute;top:50%;transform:translateY(-50%);width:58px;height:58px;border:2px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(0,0,0,.4);color:#fff;font-size:50px;line-height:45px;cursor:pointer}.slider-arrow.left{left:18px}.slider-arrow.right{right:18px}
  .slider-dots{position:absolute;left:50%;bottom:15px;transform:translateX(-50%);display:flex;gap:2px;padding:4px 8px;border-radius:20px;background:rgba(0,0,0,.7)}.slider-dots button{width:24px;height:24px;display:grid;place-items:center;border:0;border-radius:50%;background:transparent;cursor:pointer}.slider-dots button::before{content:"";width:10px;height:10px;border-radius:50%;background:#777}.slider-dots button.active::before{background:#ff1730}
  .content-section{width:min(1200px,94%);margin:auto;padding:20px 0 34px}.section-title-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:16px}.section-title-row h2{margin:0;font-size:clamp(32px,5vw,54px);letter-spacing:-2px;line-height:1}
  .section-title-row a{border:2px solid #ff1730;border-radius:28px;padding:12px 20px;color:#fff;text-decoration:none;font-size:12px;font-weight:900;letter-spacing:.5px;box-shadow:0 0 18px rgba(255,23,48,.16)}.section-title-row a span{color:#ff1730;font-size:18px;margin-left:6px}
  .other-services-section{--service-header-height:94px;width:100%;max-width:none;padding:40px 0 46px;overflow:visible}
  .other-services-section .section-title-row{width:min(1200px,94%);margin:0 auto 8px;align-items:end}.other-services-section h2{margin:0;font-size:clamp(28px,5vw,56px);letter-spacing:-2px;white-space:nowrap}.other-services-section h2 em{color:#b8ff5a}.other-services-section .section-title-row p{margin:9px 0 0;color:#eee;letter-spacing:4px;font-size:12px;font-weight:800}
  .other-services-section .section-title-row a{border-color:#b8ff5a;box-shadow:0 0 18px rgba(184,255,90,.18)}
  .other-services-section .section-title-row a span{color:#b8ff5a}
  .service-gallery-intro{width:min(1200px,94%);margin:0 auto 15px;color:#aaa;font-size:14px;line-height:1.5}
  .other-services-scrollspace{position:relative;height:auto}
  .other-services-stage{position:relative;height:auto;overflow:hidden;perspective:1700px;perspective-origin:50% 45%}
  .other-services-rail{position:relative;display:flex;align-items:center;gap:clamp(22px,4vw,66px);width:100%;padding:30px max(3vw,calc((100vw - min(1200px,94vw))/2)) 36px;overflow-x:auto;overflow-y:hidden;scroll-behavior:smooth;scroll-snap-type:x mandatory;scrollbar-width:none;transform-style:preserve-3d;touch-action:pan-x}
  .other-services-rail::-webkit-scrollbar{display:none}
  .other-service-card{position:relative;display:block;flex:0 0 min(82vw,1000px);height:min(68svh,640px);min-height:300px;overflow:hidden;border:1px solid #3a4040;border-radius:24px;background:#111517;color:#fff;text-decoration:none;scroll-snap-align:center;transform-style:preserve-3d;backface-visibility:hidden;isolation:isolate;box-shadow:0 30px 90px rgba(0,0,0,.46)}
  .other-service-card img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1)}
  .other-service-card:hover img,.other-service-card:focus-visible img{transform:scale(1.045)}
  .other-service-card:focus-visible{outline:2px solid #b8ff5a;outline-offset:5px}
  .other-service-overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;gap:10px;padding:clamp(24px,4vw,52px);background:linear-gradient(180deg,rgba(0,0,0,.08) 0%,rgba(0,0,0,.04) 38%,rgba(0,0,0,.9) 100%);transform:translateZ(22px)}
  .other-service-overlay small{color:#b8ff5a;font-size:11px;font-weight:900;letter-spacing:3px}
