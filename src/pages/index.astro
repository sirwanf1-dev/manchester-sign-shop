---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import LightboxGallery from '../components/LightboxGallery.astro';
import { signCategories, shopProducts } from '../data/website.js';

const realDir = path.join(process.cwd(), 'public', 'images', 'real-images');
const realFiles = fs.existsSync(realDir) ? fs.readdirSync(realDir).filter(file => /^real-image-(?:[1-9]|10)\.(jpe?g|png|webp)$/i.test(file)).sort((a,b)=>a.localeCompare(b,undefined,{numeric:true})) : [];
const realImages = realFiles.map(file => `/manchester-sign-shop/images/real-images/${file}`);
---

<Layout title="Manchester Sign Group | Signs, Supplies & Everything You Need">
  <main>
    <section class="hero">
      <div class="hero-heading">
        <h1>MANCHESTER <em>SIGN</em> GROUP</h1>
        <p>SIGNS <i></i> SUPPLIES <i></i> EVERYTHING YOU NEED</p>
      </div>
      <div class="hero-slider">
        {signCategories.slice(0,3).map((item,index)=>(
          <article class:list={['hero-slide',{active:index===0}]} data-slide={index}>
            <img src={item.image} alt={item.title} />
            <button class="slider-arrow left" type="button" data-prev aria-label="Previous sign">‹</button>
            <button class="slider-arrow right" type="button" data-next aria-label="Next sign">›</button>
          </article>
        ))}
        <div class="slider-dots">{signCategories.slice(0,3).map((_,index)=><button type="button" data-dot={index} aria-label={`Slide ${index+1}`}></button>)}</div>
      </div>
    </section>

    <section class="content-section signs-section" id="signs">
      <div class="section-title-row"><h2>OUR <em>SIGNS</em></h2><a href="#signs">VIEW ALL SIGNS <span>→</span></a></div>
      <div class="sign-grid">
        {signCategories.map(item=><article class="sign-card"><div class="sign-image"><img src={item.image} alt={item.title} loading="lazy" /><div class="image-shade"></div><h3>{item.title}</h3></div></article>)}
      </div>
    </section>

    <section class="estimate-section" id="estimate">
      <button class="estimate-toggle" id="estimateToggle" type="button" aria-expanded="false" aria-controls="calculator">
        <span class="estimate-icon">▣</span>
        <span class="estimate-text"><small>INSTANT SIGN ESTIMATE</small><strong>Get an estimated price for your sign.</strong></span>
        <b>›</b>
      </button>
      <div class="calculator" id="calculator" aria-hidden="true">
        <div class="field"><label>SIGN TYPE</label><select id="signType"><option value="flat">Flat Sign</option><option value="3d">3D Sign</option><option value="neon">Neon</option><option value="lightbox">Lightbox Sign</option><option value="rgb">RGB Sign</option></select></div>
        <div class="field"><label>WIDTH <small>mm</small></label><input id="width" type="number" min="100" step="50" value="1000" /></div>
        <div class="field"><label>HEIGHT <small>mm</small></label><input id="height" type="number" min="100" step="50" value="500" /></div>
        <div class="field"><label>FINISH</label><select id="finish"><option value="standard">Standard</option><option value="premium">Premium finish</option></select></div>
        <div class="estimate-output"><span>INDICATIVE STARTING PRICE</span><strong id="estimatePrice">£200</strong></div>
        <a class="quote-button" href="mailto:info@manchestersignshop.co.uk?subject=Sign%20quote%20request">REQUEST A QUOTE →</a>
      </div>
    </section>

    <section class="content-section shop-section" id="shop">
      <div class="section-title-row"><div><h2><em>SHOP</em></h2><p>SIGN MAKING SUPPLIES</p></div><a href="#shop">VIEW ALL PRODUCTS <span>→</span></a></div>
      <div class="shop-grid">{shopProducts.map(item=><article class="shop-card"><img src={item.image} alt={item.title} loading="lazy" /><div class="shop-overlay"><h3>{item.title}</h3></div></article>)}</div>
    </section>

    <section class="benefits">
      <div><b>▱</b><strong>FAST DELIVERY</strong><span>UK WIDE</span></div>
      <div><b>♢</b><strong>QUALITY PRODUCTS</strong><span>TRUSTED BRANDS</span></div>
      <div><b>▤</b><strong>SECURE PAYMENT</strong><span>SAFE & EASY</span></div>
      <div><b>♧</b><strong>EXPERT SUPPORT</strong><span>WE'RE HERE TO HELP</span></div>
    </section>

    {realImages.length > 0 && <section class="content-section real-work"><div class="section-title-row"><h2>RECENT <em>WORK</em></h2></div><LightboxGallery images={realImages} /></section>}
  </main>
</Layout>

<script>
  const slides=[...document.querySelectorAll('[data-slide]')],dots=[...document.querySelectorAll('[data-dot]')];
  let active=0,timer;
  function show(i){active=(i+slides.length)%slides.length;slides.forEach((s,n)=>s.classList.toggle('active',n===active));dots.forEach((d,n)=>d.classList.toggle('active',n===active));}
  function restart(){clearInterval(timer);timer=setInterval(()=>show(active+1),5000);}
  document.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();show(active+1);restart()}));
  document.querySelectorAll('[data-prev]').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();show(active-1);restart()}));
  dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);restart()})); if(slides.length){show(0);restart()}

  const toggle=document.querySelector('#estimateToggle'),calc=document.querySelector('#calculator');
  toggle?.addEventListener('click',()=>{const open=calc.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));calc.setAttribute('aria-hidden',String(!open))});
  const type=document.querySelector('#signType'),width=document.querySelector('#width'),height=document.querySelector('#height'),finish=document.querySelector('#finish'),output=document.querySelector('#estimatePrice');
  const rates={flat:.0004,'3d':.00075,neon:.0009,lightbox:.0007,rgb:.001},minimums={flat:150,'3d':250,'neon':300,'lightbox':250,rgb:350};
  function calculate(){const area=Math.max(0,Number(width?.value||0)*Number(height?.value||0));const price=Math.max(minimums[type?.value],Math.round(area*rates[type?.value]*(finish?.value==='premium'?1.22:1)));if(output)output.textContent=`£${price.toLocaleString('en-GB')}`}
  [type,width,height,finish].forEach(el=>el?.addEventListener('input',calculate));calculate();

  // Mobile card sliders: show two cards at once and advance one card at a time.
  function setupCardSlider(selector){
    const rail=document.querySelector(selector);
    if(!rail) return;
    const cards=[...rail.children];
    if(cards.length<3) return;
    let position=0;
    let timer;
    const step=()=>cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(rail).gap || '0');
    const max=()=>Math.max(0,cards.length-2);

    function move(){
      position = position >= max() ? 0 : position + 1;
      rail.scrollTo({left: position * step(), behavior:'smooth'});
    }

    function start(){
      clearInterval(timer);
      timer=setInterval(move,3000);
    }

    rail.addEventListener('touchstart',()=>clearInterval(timer),{passive:true});
    rail.addEventListener('touchend',start,{passive:true});
    window.addEventListener('resize',()=>{
      position=0;
      rail.scrollTo({left:0,behavior:'auto'});
      start();
    });
    start();
  }

  if(window.matchMedia('(max-width:760px)').matches){
    setupCardSlider('.sign-grid');
    setupCardSlider('.shop-grid');
  }
</script>

<style>
  :global(*){box-sizing:border-box}:global(body){overflow-x:hidden;background:#050708}main{overflow:hidden}
  .hero{width:min(1200px,94%);margin:auto;padding:20px 0 32px}.hero-heading{text-align:center;padding:0 0 18px}
  h1{margin:0;font-size:clamp(42px,7vw,82px);line-height:.95;letter-spacing:-4px;font-weight:950;white-space:nowrap}h1 em,.section-title-row h2 em,.shop-section h2 em{font-style:normal;color:#ff1730}
  .hero-heading p{margin:12px 0 0;color:#ddd;font-size:14px;letter-spacing:7px;font-weight:700}.hero-heading i{display:inline-block;width:3px;height:16px;margin:0 13px;background:#ff1730;vertical-align:-3px}
  .hero-slider{position:relative;aspect-ratio:16/7;border:1px solid #34383c;border-radius:18px;overflow:hidden;background:#121518}.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity .5s}.hero-slide.active{opacity:1}.hero-slide img{width:100%;height:100%;display:block;object-fit:cover}
  .slider-arrow{position:absolute;top:50%;transform:translateY(-50%);width:58px;height:58px;border:2px solid rgba(255,255,255,.8);border-radius:50%;background:rgba(0,0,0,.4);color:#fff;font-size:50px;line-height:45px;cursor:pointer}.slider-arrow.left{left:18px}.slider-arrow.right{right:18px}
  .slider-dots{position:absolute;left:50%;bottom:15px;transform:translateX(-50%);display:flex;gap:10px;padding:8px 15px;border-radius:20px;background:rgba(0,0,0,.7)}.slider-dots button{width:15px;height:15px;border:0;border-radius:50%;background:#555;cursor:pointer}.slider-dots button.active{background:#ff1730}
  .content-section{width:min(1200px,94%);margin:auto;padding:20px 0 34px}.section-title-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:16px}.section-title-row h2{margin:0;font-size:clamp(32px,5vw,54px);letter-spacing:-2px;line-height:1}
  .section-title-row a{border:2px solid #ff1730;border-radius:28px;padding:12px 20px;color:#fff;text-decoration:none;font-size:12px;font-weight:900;letter-spacing:.5px;box-shadow:0 0 18px rgba(255,23,48,.16)}.section-title-row a span{color:#ff1730;font-size:18px;margin-left:6px}
  .shop-section .section-title-row{align-items:end}.shop-section h2{margin:0}.shop-section p{margin:7px 0 0;color:#eee;letter-spacing:4px;font-size:12px;font-weight:800}
  .sign-grid,.shop-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}.sign-card,.shop-card{min-width:0}
  .sign-image,.shop-card{position:relative;aspect-ratio:1/1.05;border:1px solid #4a4e52;border-radius:13px;overflow:hidden;background:#15191b}.sign-image img,.shop-card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s}.sign-card:hover img,.shop-card:hover img{transform:scale(1.05)}
  .image-shade,.shop-overlay{position:absolute;inset:0;background:linear-gradient(transparent 40%,rgba(0,0,0,.85) 100%)}.sign-image h3,.shop-overlay h3{position:absolute;bottom:14px;left:16px;right:10px;margin:0;color:#fff;font-size:15px;font-weight:900;text-transform:uppercase}
  .estimate-section{width:min(1120px,92%);margin:5px auto 20px;padding:3px;border:2px solid #ff1730;border-radius:20px;background:linear-gradient(110deg,#ff1730,#b00018 55%,#ff1730);box-shadow:0 0 35px rgba(255,23,48,.28)}
  .estimate-toggle{width:100%;display:grid;grid-template-columns:85px 1fr 45px;align-items:center;gap:18px;padding:25px 42px;border:0;border-radius:16px;background:#9d071a;color:#fff;text-align:left;cursor:pointer}.estimate-icon{font-size:55px;line-height:1;text-align:center}.estimate-text{display:grid;gap:8px}.estimate-text small{font-size:12px;letter-spacing:4px;font-weight:800}.estimate-text strong{font-size:30px;line-height:1.05}.estimate-toggle>b{font-size:52px;font-weight:300;text-align:center;transition:transform .3s}.estimate-toggle[aria-expanded=true]>b{transform:rotate(90deg)}
  .calculator{display:none;grid-template-columns:repeat(2,1fr);gap:12px;padding:25px;background:#0b0d0e;border-radius:0 0 16px 16px}.calculator.open{display:grid}.field{display:grid;gap:7px}.field label{font-size:9px;color:#888;font-weight:900;letter-spacing:1.5px}.field input,.field select{width:100%;padding:13px;border:1px solid #303437;background:#15191b;color:#fff;border-radius:4px}.estimate-output{grid-column:1/-1;padding-top:15px;border-top:1px solid #303437}.estimate-output span{font-size:9px;color:#888;letter-spacing:2px}.estimate-output strong{display:block;color:#ff1730;font-size:38px;margin-top:5px}.quote-button{grid-column:1/-1;padding:15px;text-align:center;background:#ff1730;color:#fff;text-decoration:none;font-size:11px;font-weight:900;letter-spacing:1.5px}
  .shop-section{padding-top:12px}.shop-card{aspect-ratio:1/.98}.shop-overlay{background:linear-gradient(transparent 45%,rgba(0,0,0,.9) 100%)}
  .benefits{width:min(1200px,94%);margin:0 auto;padding:34px 0 25px;border-top:1px solid #303437;display:grid;grid-template-columns:repeat(4,1fr)}.benefits div{display:grid;grid-template-columns:42px 1fr;column-gap:10px;padding:0 25px;border-right:1px solid #303437}.benefits div:last-child{border:0}.benefits b{grid-row:span 2;color:#ff1730;font-size:30px}.benefits strong{font-size:12px}.benefits span{color:#888;font-size:10px;margin-top:3px}
  .real-work{padding-top:60px}
  @media(max-width:760px){
    :global(body){background:#050708}

    /* Mobile is a different layout, not a smaller desktop layout. */
    .hero{
      width:100%;
      margin:0;
      padding:14px 0 22px;
    }
    .hero-heading{
      text-align:left;
      padding:0 16px 14px;
    }
    h1{
      font-size:clamp(28px,8.2vw,38px);
      line-height:.98;
      letter-spacing:-1.8px;
      white-space:nowrap;
    }
    .hero-heading p{
      margin-top:9px;
      font-size:8px;
      letter-spacing:2.8px;
      line-height:1.4;
      white-space:nowrap;
    }
    .hero-heading i{
      height:9px;
      width:2px;
      margin:0 5px;
    }

    .hero-slider{
      width:100%;
      aspect-ratio:1.18;
      border-radius:0;
      border-left:0;
      border-right:0;
    }
    .hero-slide img{object-position:center}
    .slider-arrow{
      width:40px;
      height:40px;
      font-size:34px;
      line-height:30px;
      background:rgba(0,0,0,.55);
    }
    .slider-arrow.left{left:10px}
    .slider-arrow.right{right:10px}
    .slider-dots{
      bottom:10px;
      gap:6px;
      padding:6px 10px;
    }
    .slider-dots button{width:8px;height:8px}

    .content-section{
      width:100%;
      padding:25px 0 28px;
    }
    .section-title-row{
      align-items:flex-end;
      gap:12px;
      margin:0 16px 14px;
    }
    .section-title-row h2{
      font-size:30px;
      letter-spacing:-1.5px;
    }
    .section-title-row a{
      padding:8px 11px;
      border-radius:20px;
      font-size:8px;
      white-space:nowrap;
    }

    /* Mobile card slider: two cards visible, with reliable horizontal sliding. */
    .sign-grid,
    .shop-grid{
      display:flex !important;
      flex-wrap:nowrap !important;
      gap:10px;
      width:100%;
      padding:0 16px 8px;
      overflow-x:auto !important;
      overflow-y:hidden !important;
      scroll-behavior:smooth;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      -ms-overflow-style:none;
    }
    .sign-grid::-webkit-scrollbar,
    .shop-grid::-webkit-scrollbar{display:none}
    .sign-card,
    .shop-card{
      flex:0 0 calc((100% - 10px - 32px) / 2) !important;
      width:calc((100% - 10px - 32px) / 2) !important;
      min-width:0 !important;
      height:auto !important;
      transform:none !important;
      scroll-snap-align:start;
    }
    .sign-image,
    .shop-card{
      display:block !important;
      width:100% !important;
      height:auto !important;
      min-height:140px !important;
      aspect-ratio:1.18/1 !important;
      border-radius:10px;
    }
    .sign-image h3,
    .shop-overlay h3{
      left:9px;
      bottom:8px;
      font-size:10px;
    }
    .sign-image img,
    .shop-card img{
      transform:scale(1) !important;
      object-fit:cover;
    }
    .sign-grid .sign-card:last-child{grid-column:auto}

    /* The estimate becomes a compact, thumb-friendly action bar. */
    .estimate-section{
      width:calc(100% - 32px);
      margin:3px 16px 22px;
      border-radius:14px;
      padding:2px;
    }
    .estimate-toggle{
      grid-template-columns:38px 1fr 25px;
      gap:9px;
      padding:16px 14px;
      border-radius:11px;
    }
    .estimate-icon{font-size:28px}
    .estimate-text{gap:5px}
    .estimate-text small{
      font-size:7px;
      letter-spacing:1.8px;
    }
    .estimate-text strong{
      font-size:16px;
      line-height:1.15;
    }
    .estimate-toggle>b{font-size:32px}
    .calculator{
      grid-template-columns:1fr;
      gap:10px;
      padding:13px;
    }
    .estimate-output,
    .quote-button{grid-column:auto}

    .shop-section{
      padding-top:8px;
    }
    .shop-section .section-title-row{
      align-items:flex-end;
    }
    .shop-section p{
      margin-top:5px;
      font-size:8px;
      letter-spacing:2.5px;
    }

    .benefits{
      width:100%;
      padding:24px 16px 18px;
      grid-template-columns:1fr 1fr;
      gap:0;
    }
    .benefits div{
      min-height:70px;
      padding:10px 10px;
      border-right:1px solid #303437;
      border-bottom:1px solid #303437;
    }
    .benefits div:nth-child(even){border-right:0}
    .benefits div:nth-child(n+3){border-bottom:0}
    .benefits b{font-size:24px}
    .benefits strong{font-size:10px}
    .benefits span{font-size:8px}

    .real-work{padding-top:36px}
  }
</style>
