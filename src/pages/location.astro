---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sign Makers in Manchester & Greater Manchester" description="Manchester Sign Group provides signage services and sign-making supplies across Manchester and Greater Manchester. Contact us to discuss your project and service area.">
  <main class="inner-page">
    <div class="page-head"><small>WHERE WE WORK</small><h1><em>LOCATION</em></h1><p>We provide sign services across Manchester and Greater Manchester. Contact us before visiting so we can confirm the correct location for your project.</p></div>
    <div class="location-card"><strong>MANCHESTER & GREATER MANCHESTER</strong><span>SIGN SERVICES • SUPPLIES • INSTALLATION</span><a href="https://wa.me/447594106206?text=Hi%20Manchester%2C%20I%20would%20like%20to%20ask about%20your%20location%20and%20service%20area." target="_blank" rel="noopener">CONTACT US FOR DETAILS →</a></div>
  </main>
</Layout>
<style>
  .inner-page{width:min(900px,92%);margin:auto;padding:70px 0 90px}.page-head small{color:#ff1730;font-size:11px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(42px,7vw,76px);line-height:.95;letter-spacing:-3px}.page-head h1 em{font-style:normal;color:#ff1730}.page-head p{color:#aaa;line-height:1.6;max-width:680px}.location-card{margin-top:35px;padding:35px;border:1px solid #303437;border-radius:14px;background:#0c0f11}.location-card strong{display:block;font-size:20px}.location-card span{display:block;color:#888;margin-top:9px;font-size:10px;letter-spacing:2px}.location-card a{display:inline-block;margin-top:24px;color:#ff1730;text-decoration:none;font-size:11px;font-weight:900}@media(max-width:600px){.inner-page{padding:48px 0 65px}}
</style>