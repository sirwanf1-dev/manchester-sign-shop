<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#050708" />
  <title>Login | Manchester Sign Group</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Manchester Sign Group home"><span class="brand-mark">M</span><span>MANCHESTER SIGN GROUP</span></a>
      <a class="back-link" href="/">VIEW WEBSITE ↗</a>
    </header>

    <section class="intro">
      <h1 id="authTitle">LOGIN</h1>
    </section>

    <section class="login-card" id="loginCard">
      <form id="authForm">
        <label for="managerEmail">Email</label>
        <input id="managerEmail" type="email" placeholder="Enter your email" autocomplete="username" required />
        <label for="managerPassword">Password</label>
        <input id="managerPassword" type="password" autocomplete="current-password" minlength="8" placeholder="Enter your password" required />
        <button class="primary" type="submit" id="authButton">LOGIN <span>→</span></button>
      </form>
      <p class="status" id="authStatus" role="status" aria-live="polite"></p>
    </section>

    <section class="manager" id="manager" hidden>
      <div class="connected-row"><p>Signed in as <strong id="managerUser"></strong></p><button type="button" class="text-button" id="logoutButton">SIGN OUT</button></div>
      <div class="manager-grid">
        <section class="panel">
          <div class="card-heading"><span class="step">02</span><div><h2>Homepage slideshow</h2><p>Add photos to the end of the homepage slideshow.</p></div></div>
          <form id="slideForm" class="upload-form">
            <label class="dropzone" for="slideFiles"><span class="upload-icon">↑</span><strong>Choose slideshow photos</strong><small>JPG, PNG or WebP · up to 8 MB each · up to 10 at a time</small><input id="slideFiles" type="file" accept="image/jpeg,image/png,image/webp" multiple required /></label>
            <button class="primary" type="submit" id="slideButton">ADD TO SLIDESHOW <span>→</span></button>
          </form>
          <p class="status" id="slideStatus" role="status" aria-live="polite"></p>
          <div class="preview-heading"><h3>Photos you’ve uploaded</h3><span id="slideCount"></span></div>
          <div class="thumb-grid" id="slideGallery"></div>
          <p class="small-note">Photos already on the website remain in the slideshow.</p>
        </section>

        <section class="panel">
          <div class="card-heading"><span class="step">03</span><div><h2>Service photos</h2><p>Choose a service and upload a new photo for its cards.</p></div></div>
          <form id="serviceForm" class="upload-form">
            <label for="serviceChoice">Service</label>
            <select id="serviceChoice">
              <option value="repair">Sign repairs & lighting faults</option>
              <option value="cleaning">Sign cleaning</option>
              <option value="repainting">Sign painting & repainting</option>
              <option value="other">Other sign services</option>
            </select>
            <label class="dropzone compact" for="serviceFile"><span class="upload-icon">↑</span><strong>Choose a service photo</strong><small>JPG, PNG or WebP · up to 8 MB</small><input id="serviceFile" type="file" accept="image/jpeg,image/png,image/webp" required /></label>
            <button class="primary" type="submit" id="serviceButton">UPDATE SERVICE PHOTO <span>→</span></button>
          </form>
          <p class="status" id="serviceStatus" role="status" aria-live="polite"></p>
          <div class="preview-heading"><h3>Current service photos</h3></div>
          <div class="service-gallery" id="serviceGallery"></div>
        </section>
      </div>
      <div class="deploy-note"><span>✓</span><p>Uploads are saved securely and appear on the website shortly. Your sign-in stays available on this browser until you sign out.</p></div>
    </section>
    <footer>Manchester Sign Group · Secure sign-in and image uploads.</footer>
  </main>
<script>
  import { supabase } from '../lib/supabase.js';

  const BUCKET = 'website-images';
  const serviceLabels = {
    repair: 'Sign repairs & lighting faults',
    cleaning: 'Sign cleaning',
    repainting: 'Sign painting & repainting',
    other: 'Other sign services'
  };
  const byId = id => document.getElementById(id);

  function setStatus(id, message, isError = false) {
    const node = byId(id);
    node.textContent = message;
    node.classList.toggle('error', isError);
  }
  function friendlyError(error) {
    return error?.message || 'Something went wrong. Please try again.';
  }
  function fileExtension(file) {
    if (file.type === 'image/png') return 'png';
    if (file.type === 'image/webp') return 'webp';
    return 'jpg';
  }
  function validateImage(file) {
    if (!file || !['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
      throw new Error('Choose a JPG, PNG or WebP image.');
    }
    if (file.size > 8 * 1024 * 1024) throw new Error('Each image must be 8 MB or smaller.');
  }
  function safeName(file) {
    return file.name.replace(/\.[^.]+$/, '').toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 48) || 'photo';
  }
  function publicImageUrl(path) {
    return supabase.storage.from(BUCKET).getPublicUrl(path).data.publicUrl;
  }
  async function listImages(folder) {
    const { data, error } = await supabase.storage.from(BUCKET).list(folder, {
      limit: 1000,
      sortBy: { column: 'name', order: 'asc' }
    });
    if (error) throw error;
    return (data || []).filter(file => /\.(?:jpe?g|png|webp)$/i.test(file.name));
  }
  function addThumbnail(container, src, alt, title) {
    const figure = document.createElement('figure');
    const image = document.createElement('img');
    image.src = src;
    image.alt = alt;
    image.loading = 'lazy';
    const caption = document.createElement('figcaption');
    caption.textContent = title;
    figure.append(image, caption);
    container.append(figure);
  }
  function setBusy(button, busy, busyLabel) {
    button.disabled = busy;
    button.dataset.originalLabel ||= button.innerHTML;
    button.innerHTML = busy ? busyLabel : button.dataset.originalLabel;
  }
  function newestFirst(files) {
    return [...files].sort((a, b) => {
      const dateA = new Date(a.updated_at || a.created_at || 0).getTime();
      const dateB = new Date(b.updated_at || b.created_at || 0).getTime();
      return dateB - dateA;
    });
  }
  async function refreshManager() {
    const [slides, serviceFiles] = await Promise.all([listImages('slides'), listImages('services')]);
    const slideGallery = byId('slideGallery');
    slideGallery.replaceChildren();
    slides.forEach(file => addThumbnail(slideGallery, publicImageUrl('slides/' + file.name), file.name, file.name));
    byId('slideCount').textContent = slides.length + ' photo' + (slides.length === 1 ? '' : 's');
    if (!slides.length) {
      const note = document.createElement('p');
      note.className = 'empty-note';
      note.textContent = 'No new photos uploaded yet.';
      slideGallery.append(note);
    }

    const latestByService = {};
    newestFirst(serviceFiles).forEach(file => {
      const key = Object.keys(serviceLabels).find(service => file.name.startsWith(service + '-'));
      if (key && !latestByService[key]) latestByService[key] = file;
    });
    const serviceGallery = byId('serviceGallery');
    serviceGallery.replaceChildren();
    Object.entries(serviceLabels).forEach(([key, label]) => {
      const file = latestByService[key];
      if (file) {
        addThumbnail(serviceGallery, publicImageUrl('services/' + file.name), label, label);
      } else {
        const figure = document.createElement('figure');
        const empty = document.createElement('div');
        empty.className = 'empty-preview';
        empty.textContent = 'No photo uploaded';
        const caption = document.createElement('figcaption');
        caption.textContent = label;
        figure.append(empty, caption);
        serviceGallery.append(figure);
      }
    });
  }

  async function enterManager(user) {
    const email = (user?.email || '').toLowerCase();
    const { data: managerAccess, error: accessError } = await supabase
      .from('website_managers')
      .select('email')
      .eq('email', email)
      .maybeSingle();
    if (accessError || !managerAccess) {
      await supabase.auth.signOut();
      throw new Error('This account does not have access.');
    }
    byId('managerUser').textContent = user.email;
    byId('loginCard').hidden = true;
    byId('manager').hidden = false;
    setStatus('authStatus', '');
    return refreshManager().catch(error => {
      setStatus('slideStatus', 'Signed in, but could not load images: ' + friendlyError(error), true);
    });
  }

  byId('authForm').addEventListener('submit', async event => {
    event.preventDefault();
    const email = byId('managerEmail').value.trim().toLowerCase();
    const password = byId('managerPassword').value;
    const button = byId('authButton');
    setBusy(button, true, 'SIGNING IN…');
    setStatus('authStatus', 'Checking your sign-in…');
    try {
      const { data, error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) throw error;
      await enterManager(data.user);
      byId('managerPassword').value = '';
    } catch (error) {
      setStatus('authStatus', friendlyError(error), true);
    } finally {
      setBusy(button, false, '');
    }
  });

  byId('logoutButton').addEventListener('click', async () => {
    await supabase.auth.signOut();
    byId('manager').hidden = true;
    byId('loginCard').hidden = false;
    byId('slideGallery').replaceChildren();
    byId('serviceGallery').replaceChildren();
    byId('managerPassword').value = '';
    setStatus('authStatus', 'Signed out.');
  });

  byId('slideForm').addEventListener('submit', async event => {
    event.preventDefault();
    const button = byId('slideButton');
    const files = [...byId('slideFiles').files];
    if (!files.length) return;
    try {
      if (files.length > 10) throw new Error('Upload up to 10 photos at a time.');
      files.forEach(validateImage);
      setBusy(button, true, 'UPLOADING…');
      setStatus('slideStatus', 'Uploading your slideshow photos…');
      for (let index = 0; index < files.length; index++) {
        const file = files[index];
        const filename = Date.now() + '-' + String(index + 1).padStart(2, '0') + '-' + crypto.randomUUID().slice(0, 8) + '-' + safeName(file) + '.' + fileExtension(file);
        const { error } = await supabase.storage.from(BUCKET).upload('slides/' + filename, file, {
          cacheControl: '3600',
          contentType: file.type,
          upsert: false
        });
        if (error) throw error;
      }
      byId('slideFiles').value = '';
      await refreshManager();
      setStatus('slideStatus', 'Photos added. They will appear in the homepage slideshow shortly.');
    } catch (error) {
      setStatus('slideStatus', friendlyError(error), true);
    } finally {
      setBusy(button, false, '');
    }
  });

  byId('serviceForm').addEventListener('submit', async event => {
    event.preventDefault();
    const button = byId('serviceButton');
    const file = byId('serviceFile').files[0];
    const key = byId('serviceChoice').value;
    try {
      validateImage(file);
      setBusy(button, true, 'UPDATING…');
      setStatus('serviceStatus', 'Uploading the new service photo…');
      const oldFiles = await listImages('services');
      const filename = key + '-' + Date.now() + '-' + crypto.randomUUID().slice(0, 8) + '.' + fileExtension(file);
      const { error } = await supabase.storage.from(BUCKET).upload('services/' + filename, file, {
        cacheControl: '3600',
        contentType: file.type,
        upsert: false
      });
      if (error) throw error;
      const stalePaths = oldFiles
        .filter(oldFile => oldFile.name.startsWith(key + '-'))
        .map(oldFile => 'services/' + oldFile.name);
      if (stalePaths.length) {
        const { error: removeError } = await supabase.storage.from(BUCKET).remove(stalePaths);
        if (removeError) console.warn('Could not remove previous service photo:', removeError.message);
      }
      byId('serviceFile').value = '';
      await refreshManager();
      setStatus('serviceStatus', serviceLabels[key] + ' photo updated on the website.');
    } catch (error) {
      setStatus('serviceStatus', friendlyError(error), true);
    } finally {
      setBusy(button, false, '');
    }
  });

  async function restoreSession() {
    const { data, error } = await supabase.auth.getSession();
    if (error) {
      setStatus('authStatus', friendlyError(error), true);
      return;
    }
    if (data.session?.user) {
      try {
        await enterManager(data.session.user);
      } catch (problem) {
        setStatus('authStatus', friendlyError(problem), true);
      }
    }
  }
  restoreSession();
</script>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#050708;color:#f7f7f8;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  .shell{width:min(1180px,92%);margin:auto}
  .topbar{height:86px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #202326}
  .brand{display:flex;align-items:center;gap:12px;color:#fff;text-decoration:none;font-size:12px;font-weight:900;letter-spacing:2px}
  .brand-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:8px;background:#e31b35;color:#fff;font-size:25px;letter-spacing:-2px}
  .back-link{color:#b8ff5a;text-decoration:none;font-size:11px;font-weight:900;letter-spacing:1px}
  .intro{padding:48px 0 16px}
  .eyebrow{margin:0 0 9px;color:#b8ff5a;font-size:10px;font-weight:900;letter-spacing:3px}
  .intro h1{margin:0;font-size:clamp(38px,6vw,62px);letter-spacing:-2px}
  .intro h1 em{font-style:normal;color:#b8ff5a}
  .lede{max-width:650px;color:#aaa;line-height:1.6}
  .login-card,.panel{border:1px solid #303437;border-radius:14px;background:#0c0f11;padding:24px}
  .login-card{max-width:480px;margin:12px 0 40px}
  .card-heading{display:flex;align-items:flex-start;gap:14px;margin-bottom:22px}
  .step{display:grid;place-items:center;flex:none;width:34px;height:34px;border:1px solid #b8ff5a;border-radius:50%;color:#b8ff5a;font-size:11px;font-weight:900}
  .card-heading h2{margin:0 0 6px;font-size:20px}
  .card-heading p{margin:0;color:#96999c;font-size:13px;line-height:1.5}
  #authForm,.upload-form{display:grid;gap:12px}
  #authForm label,.upload-form>label:not(.dropzone){font-size:12px;font-weight:800;color:#eee}
  #authForm input,.upload-form select{width:100%;min-height:46px;padding:12px 14px;border:1px solid #45494d;border-radius:8px;background:#080a0b;color:#fff;font:inherit}
  #authForm input[readonly]{color:#cdd0d2}
  .primary{min-height:46px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border:0;border-radius:8px;background:#ff1730;color:#fff;font-size:11px;font-weight:900;letter-spacing:1px;cursor:pointer}
  .primary span{font-size:18px}
  .primary:disabled{opacity:.6;cursor:wait}
  .small-note{color:#92989c;font-size:12px;line-height:1.55}
  .status{min-height:18px;margin:12px 0 0;color:#b8ff5a;font-size:12px;line-height:1.5}
  .status.error{color:#ff8a96}
  .manager[hidden],.login-card[hidden]{display:none}
  .connected-row{display:flex;justify-content:space-between;align-items:center;margin:8px 0 16px;color:#aeb2b6;font-size:13px}
  .connected-row strong{color:#fff}
  .text-button{padding:9px 12px;border:1px solid #45494d;border-radius:7px;background:transparent;color:#fff;font-size:10px;font-weight:900;letter-spacing:1px;cursor:pointer}
  .manager-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:16px}
  .panel{min-width:0}
  .dropzone{position:relative;display:flex;min-height:138px;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:16px;border:1px dashed #555d62;border-radius:10px;background:#090b0d;text-align:center;cursor:pointer}
  .dropzone:hover{border-color:#b8ff5a}
  .dropzone.compact{min-height:122px}
  .upload-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#171d18;color:#b8ff5a;font-size:20px;font-weight:900}
  .dropzone strong{font-size:13px}
  .dropzone small{color:#92989c;font-size:11px}
  .dropzone input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
  .preview-heading{display:flex;align-items:center;justify-content:space-between;margin:23px 0 10px}
  .preview-heading h3{margin:0;font-size:13px}
  .preview-heading span{color:#a5aaad;font-size:11px}
  .thumb-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;max-height:310px;overflow:auto}
  .thumb-grid figure,.service-gallery figure{min-width:0;margin:0;overflow:hidden;border:1px solid #292d30;border-radius:8px;background:#080a0b}
  .thumb-grid img{display:block;width:100%;aspect-ratio:1.35;object-fit:cover}
  .thumb-grid figcaption,.service-gallery figcaption{padding:7px;color:#b9bdc0;font-size:10px;line-height:1.35}
  .service-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  .service-gallery img,.empty-preview{display:block;width:100%;aspect-ratio:1.5;object-fit:cover;background:#101317}
  .empty-preview{display:grid;place-items:center;padding:10px;color:#71777b;font-size:11px;text-align:center}
  .empty-note{grid-column:1/-1;margin:0;padding:18px;border:1px dashed #35393d;border-radius:8px;color:#92989c;font-size:12px;text-align:center}
  .small-note{margin:10px 0 0}
  .deploy-note{display:flex;align-items:center;gap:12px;margin:16px 0 40px;padding:16px;border:1px solid #29352a;border-radius:10px;background:#0b100b;color:#aeb8ab}
  .deploy-note span{color:#b8ff5a;font-size:21px}
  .deploy-note p{margin:0;font-size:12px;line-height:1.5}
  footer{padding:20px 0 30px;border-top:1px solid #202326;color:#73797d;font-size:11px}
  @media(max-width:800px){.manager-grid{grid-template-columns:1fr}.intro{padding-top:35px}.panel,.login-card{padding:19px}}
  @media(max-width:480px){.shell{width:92%}.topbar{height:72px}.brand{font-size:9px;letter-spacing:1.3px}.brand-mark{width:32px;height:32px}.back-link{font-size:9px}.intro h1{font-size:39px}.connected-row{align-items:flex-start}.thumb-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.service-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
</body>
</html>
