---
import Layout from '../layouts/Layout.astro';
import serviceImages from '../data/service-images.json';
const serviceImageSrcset = image => `${image.replace(/\.webp$/i, '-640.webp')} 640w, ${image} 1200w`;
---
<Layout title="Sign Repairs, Cleaning & Fitting | Manchester Sign Group" description="Sign repairs, lighting fault checks, cleaning and installation for suitable projects in Manchester and across the UK.">
  <main class="inner-page">
    <header class="page-head">
      <small>REPAIRS & SIGN INSTALLATION</small>
      <h1>OTHER <em>SERVICES</em></h1>
      <p>Need help with a sign? We can help with repairs, lighting faults, cleaning and installation for suitable projects. Send us a photo and a few details and we’ll discuss the next step.</p>
    </header>

    <section class="service-grid" aria-label="Additional sign services">
      <article class="service-card">
        <img src={serviceImages.repair} srcset={serviceImageSrcset(serviceImages.repair)} sizes="(max-width: 700px) 92vw, (max-width: 1120px) 46vw, 550px" data-service-image="repair" alt="Illuminated shop sign with one unlit letter, ready for repair" loading="lazy" decoding="async" />
        <div><small>01 / REPAIR</small><h2>Sign repairs & lighting faults</h2><p>One letter gone dark, damaged lettering or a sign that is not working as it should? We can assess the issue and advise on repair options.</p></div>
      </article>
      <article class="service-card">
        <img src={serviceImages.cleaning} srcset={serviceImageSrcset(serviceImages.cleaning)} sizes="(max-width: 700px) 92vw, (max-width: 1120px) 46vw, 550px" data-service-image="cleaning" alt="A sign cleaner wiping grime from raised shop sign letters" loading="lazy" decoding="async" />
        <div><small>02 / CLEANING</small><h2>Sign cleaning</h2><p>Refresh the look of your shopfront with sign cleaning to remove everyday dirt and help your business stand out again.</p></div>
      </article>
      <article class="service-card">
        <img src={serviceImages.installation} srcset={serviceImageSrcset(serviceImages.installation)} sizes="(max-width: 700px) 92vw, (max-width: 1120px) 46vw, 550px" data-service-image="installation" alt="Illustrative photo of an installer fitting an NHS sign at a health centre" loading="lazy" decoding="async" />
        <div><small>03 / INSTALLATION</small><h2>Sign installation & fitting</h2><p>Installation can be arranged for suitable signage projects. Tell us the sign type, location and fitting requirements so we can advise.</p></div>
      </article>
    </section>

    <section class="service-faq" aria-labelledby="service-faq-title">
      <h2 id="service-faq-title">COMMON <em>QUESTIONS</em></h2>
      <details><summary>Can you repair a sign when one letter has gone dark?</summary><p>We can assess signs with unlit letters and other lighting faults. Send a photo and your town or postcode so we can advise.</p></details>
      <details><summary>Do you clean existing business signs?</summary><p>Yes, sign cleaning is available for suitable signs and locations. Send a photo so we can review it.</p></details>
      <details><summary>Do you install and fit signs?</summary><p>We can arrange installation and fitting for suitable projects. Include the sign type and installation location in your enquiry.</p></details>
      <details><summary>What should I send for an estimate?</summary><p>Share a photo, the sign type and approximate size, plus your town or postcode. For installation, include any access details you know.</p></details>
    </section>

    <section class="contact-panel">
      <div><small>GET STARTED</small><h2>Show us what you need</h2><p>Call us or send a photo of your sign, your location and a short description.</p></div>
      <div class="contact-actions"><a class="call-link" href="tel:+447594106206">CALL 07594 106206</a><a class="whatsapp-link" href="https://wa.me/447594106206?text=Hi%20Manchester%20Sign%20Group%2C%20I%20would%20like%20a%20quote%20for%20sign%20repairs%2C%20cleaning%20or%20installation.%20I%20can%20send%20a%20photo." target="_blank" rel="noopener">SEND A PHOTO ON WHATSAPP <span>→</span></a></div>
    </section>
  </main>
</Layout>
<script>
  import { supabase } from '../lib/supabase.js';

  async function loadUploadedServicePhotos(){
    const {data,error}=await supabase.storage.from('website-images').list('services',{limit:1000,sortBy:{column:'name',order:'asc'}});
    if(error||!data) return;
    const latest={};
    const files=data
      .filter(file=>/\.(?:jpe?g|png|webp)$/i.test(file.name))
      .sort((a,b)=>new Date(b.updated_at||b.created_at||0)-new Date(a.updated_at||a.created_at||0));
    files.forEach(file=>{
      const key=['repair','cleaning','installation'].find(service=>file.name.startsWith(service+'-'));
      if(key&&!latest[key]) latest[key]=file;
    });
    document.querySelectorAll('[data-service-image]').forEach(image=>{
      const file=latest[image.dataset.serviceImage];
      if(file){
        image.removeAttribute('srcset');
        image.removeAttribute('sizes');
        image.src=supabase.storage.from('website-images').getPublicUrl('services/'+file.name).data.publicUrl;
      }
    });
  }
  loadUploadedServicePhotos().catch(error=>console.warn('Could not load uploaded service photos:',error.message));
</script>
<style>
  .inner-page{width:min(1120px,92%);margin:auto;padding:70px 0 90px}.page-head{max-width:760px;margin-bottom:34px}.page-head small,.service-card small,.contact-panel small{color:#b8ff5a;font-size:10px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(32px,5vw,60px);line-height:.95;letter-spacing:-2px;white-space:nowrap;color:#b8ff5a}.page-head h1 em{font-style:normal;color:inherit}.page-head p{color:#aaa;line-height:1.65;font-size:15px}.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.service-card{overflow:hidden;border:1px solid #303437;border-radius:14px;background:#0c0f11}.service-card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:#101317}.service-card>div{padding:20px 22px 23px}.service-card h2{margin:9px 0 8px;font-size:21px;letter-spacing:-.5px}.service-card p{margin:0;color:#aaa;font-size:14px;line-height:1.6}.service-faq{margin-top:38px}.service-faq>h2{margin:0 0 14px;font-size:clamp(22px,3vw,30px);letter-spacing:-.7px}.service-faq>h2 em{font-style:normal;color:#b8ff5a}.service-faq details{border-top:1px solid #303437}.service-faq details:last-child{border-bottom:1px solid #303437}.service-faq summary{padding:16px 2px;color:#f4f4f4;font-weight:750;cursor:pointer}.service-faq details p{margin:0;padding:0 2px 16px;color:#aaa;font-size:14px;line-height:1.6}.contact-panel{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:24px;padding:26px;border:1px solid #303437;border-radius:14px;background:#101316}.contact-panel h2{margin:8px 0;font-size:24px}.contact-panel p{margin:0;color:#aaa;line-height:1.5}.contact-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex:none;flex-wrap:wrap}.contact-panel .contact-actions a{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 18px;border:1px solid transparent;border-radius:8px;background:#ff1730;color:#fff;text-decoration:none;font-size:11px;font-weight:900;letter-spacing:.6px}.contact-panel .contact-actions .call-link{border-color:#b8ff5a;background:transparent}.contact-actions a span{font-size:18px}@media(max-width:700px){.inner-page{padding:48px 0 65px}.service-grid{grid-template-columns:1fr}.service-card>div{padding:18px}.contact-panel{align-items:flex-start;flex-direction:column;padding:21px}.contact-actions{width:100%;flex-direction:column}.contact-panel .contact-actions a{width:100%}.page-head h1{font-size:clamp(25px,8vw,34px);letter-spacing:-1px}}
</style>
