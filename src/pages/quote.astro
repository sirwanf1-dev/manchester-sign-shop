---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Request a Sign Quote | Manchester Sign Group" description="Request a quote for 3D, RGB, flat or neon signs and printed boards from our Manchester-based team, with throughout the United Kingdom delivery and a one-year product warranty.">
  <main class="inner-page">
    <div class="page-head"><small>START YOUR PROJECT</small><h1>REQUEST A <em>QUOTE</em></h1><p>Send us your requirements and we will get back to you.</p></div>
    <form id="quoteForm" class="quote-form">
      <input required name="name" placeholder="Your name" />
      <input name="company" placeholder="Company name" />
      <input required name="phone" type="tel" placeholder="Phone number" />
      <input name="email" type="email" placeholder="Email address" />
      <select name="type"><option>3D Sign</option><option>RGB 3D Sign</option><option>Flat Sign</option><option>Print on Board</option><option>Cut Vinyl Board</option><option>Neon</option><option>Other</option></select>
      <div class="sizes"><input name="width" type="number" placeholder="Width (cm)" /><input name="height" type="number" placeholder="Height (cm)" /></div>
      <textarea name="message" rows="5" placeholder="Tell us what you need"></textarea>
      <button type="submit">SEND REQUEST →</button>
    </form>
  </main>
</Layout>
<script>
  const form=document.querySelector('#quoteForm');
  form?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const msg=['Hi Manchester,','','QUOTE REQUEST',`Name: ${d.get('name')}`,`Company: ${d.get('company')||'Not provided'}`,`Phone: ${d.get('phone')}`,`Email: ${d.get('email')||'Not provided'}`,`Type: ${d.get('type')}`,`Size: ${d.get('width')||'?'} × ${d.get('height')||'?'} cm`,`Details: ${d.get('message')||'Not provided'}`,'','Please contact me about this quote.'].join('\n');window.open('https://wa.me/447594106206?text='+encodeURIComponent(msg),'_blank')});
</script>
<style>
.inner-page{width:min(850px,92%);margin:auto;padding:70px 0 90px}.page-head{margin-bottom:30px}.page-head small{color:#ff1730;font-size:11px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(42px,7vw,76px);line-height:.95;letter-spacing:-3px}.page-head h1 em{font-style:normal;color:#ff1730}.page-head p{color:#aaa}.quote-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quote-form input,.quote-form select,.quote-form textarea{width:100%;padding:14px;border:1px solid #303437;border-radius:8px;background:#0c0f11;color:#fff;font:inherit}.quote-form textarea{grid-column:1/-1;resize:vertical}.sizes{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quote-form button{grid-column:1/-1;padding:16px;border:0;border-radius:8px;background:#ff1730;color:#fff;font-weight:900;letter-spacing:1px;font-size:12px}@media(max-width:600px){.inner-page{padding:48px 0 65px}.quote-form{grid-template-columns:1fr}.quote-form textarea,.quote-form button{grid-column:auto}.sizes{grid-template-columns:1fr 1fr}}
</style>