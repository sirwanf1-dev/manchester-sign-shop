---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Our Services | Manchester Sign Group">
  <main class="inner-page">
    <div class="page-head"><small>WHAT WE DO</small><h1>OUR <em>SERVICES</em></h1><p>Professional signage and visual branding for businesses across Manchester and Greater Manchester.</p></div>
    <section class="service-grid">
      <article><b>01</b><h2>3D & RGB SIGNS</h2><p>Built-up 3D lettering, illuminated options and RGB LED signage for strong shopfront visibility.</p></article>
      <article><b>02</b><h2>FLAT & BOARD SIGNS</h2><p>Printed board signs and clean flat signage for shops, offices, businesses and outdoor use.</p></article>
      <article><b>03</b><h2>NEON SIGNS</h2><p>Custom neon-style signage for businesses, interiors, hospitality and branded spaces.</p></article>
      <article><b>04</b><h2>CUT VINYL</h2><p>Cut vinyl lettering and graphics for boards, windows, walls and other smooth surfaces.</p></article>
      <article><b>05</b><h2>WINDOW GRAPHICS</h2><p>Printed and vinyl window graphics for branding, promotions, privacy and shopfronts.</p></article>
      <article><b>06</b><h2>INSTALLATION</h2><p>Professional sign installation can be arranged for suitable projects.</p></article>
    </section>
    <a class="page-button" href="https://wa.me/447594106206?text=Hi%20Manchester%2C%20I%20would%20like%20to%20ask%20about%20your%20sign%20services." target="_blank" rel="noopener">ASK ABOUT A SERVICE →</a>
  </main>
</Layout>
<style>
  .inner-page{width:min(1120px,92%);margin:auto;padding:70px 0 90px}.page-head{max-width:760px;margin-bottom:35px}.page-head small{color:#ff1730;font-size:11px;font-weight:900;letter-spacing:3px}.page-head h1{margin:10px 0 14px;font-size:clamp(42px,7vw,76px);line-height:.95;letter-spacing:-3px}.page-head h1 em{font-style:normal;color:#ff1730}.page-head p{color:#aaa;line-height:1.6;font-size:15px}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.service-grid article{padding:24px;border:1px solid #303437;border-radius:12px;background:#0c0f11}.service-grid b{color:#ff1730;font-size:11px;letter-spacing:2px}.service-grid h2{margin:12px 0 8px;font-size:18px}.service-grid p{margin:0;color:#888;font-size:13px;line-height:1.55}.page-button{display:inline-flex;margin-top:28px;padding:15px 20px;background:#ff1730;color:#fff;text-decoration:none;border-radius:8px;font-size:11px;font-weight:900;letter-spacing:1px}@media(max-width:600px){.inner-page{padding:48px 0 65px}.service-grid{grid-template-columns:1fr}.page-head h1{font-size:44px}}
</style>